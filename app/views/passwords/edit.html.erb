<div class="card mx-auto w-full p-6 sm:p-8" style="max-width: 25rem;">
  <h1 class="mb-6 text-center text-2xl font-semibold">Change your password</h1>

  <%= form_with(url: password_path, method: :patch, class: "flex flex-col gap-4") do |form| %>
    <% if @user.errors.any? %>
      <%= render "shared/error_messages", object: @user %>
    <% end %>

    <div>
      <%= form.label :password_challenge, class: "mb-1 block text-sm font-semibold" %>
      <%= form.password_field :password_challenge, required: true, autofocus: true, autocomplete: "current-password", class: "input" %>
    </div>

    <div>
      <%= form.label :password, "New password", class: "mb-1 block text-sm font-semibold" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", class: "input" %>
      <div class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">12 characters minimum.</div>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm new password", class: "mb-1 block text-sm font-semibold" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "input" %>
    </div>

    <%= form.submit "Save changes", class: "btn btn--primary w-full" %>
  <% end %>

  <div class="mt-6 text-center text-sm">
    <%= link_to "Back", root_path, class: "font-medium text-orange-600 hover:underline dark:text-orange-400" %>
  </div>
</div>
