<% content_for :title, "Edit #{@device.name}" %>

<% content_for :page_header do %><%= @device.name %><% end %>

<div class="mx-auto flex w-full max-w-3xl flex-col gap-4">
  <div>
    <%= link_to :back, class: "btn shrink-0 !p-2", aria: { label: "Back" } do %>
      <%= icon("chevron-left", "h-4 w-4") %>
    <% end %>
  </div>

  <div class="card p-4 sm:p-6">
    <h1 class="mb-4 truncate text-2xl font-bold">Edit <%= @device.name %></h1>
    <%= render "form", device: @device %>
  </div>
</div>
