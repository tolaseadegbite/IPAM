<%
  # The assigned IP is passed explicitly so devices with any number of
  # interfaces render one block each (plus one blank block for a new one).
  assigned_ip = local_assigns[:assigned_ip]
%>

<div class="grid grid-cols-1 gap-4 rounded-lg bg-zinc-100 p-4 sm:grid-cols-2 dark:bg-white/5"
     data-controller="dependent-select" 
     data-dependent-select-url-value="<%= select_options_ip_addresses_path(field_name: 'device[ip_address_ids][]', frame_id: "ip_options_#{id}") %>"
     data-dependent-select-param-value="subnet_id"
     data-dependent-select-frame-id-value="ip_options_<%= id %>">
       
  <!-- Subnet Filter -->
  <div>
    <label class="mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400">Filter Subnet</label>
    <%= select_tag "subnet_filter_#{id}",
          options_for_select(Subnet.order(:name).map { |s| [ s.name, s.id, { "data-branch-id" => s.branch_id } ] }, assigned_ip&.subnet_id),
          prompt: "Select Network...",
          class: "input w-full cursor-pointer",
          data: { dependent_select_target: "select", subnet_scope_target: "filter", action: "change->dependent-select#load" } %>
  </div>
  
  <!-- IP Select -->
  <div>
    <label class="mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400">Select IP</label>
    <%= turbo_frame_tag "ip_options_#{id}", data: { dependent_select_target: "frame" } do %>
      <% 
         # If an IP is already assigned, load that subnet's free IPs + the assigned IP
         # If no IP is assigned, load nothing until the user picks a subnet
         ips = if assigned_ip
                 IpAddress.where(subnet_id: assigned_ip.subnet_id).free.or(IpAddress.where(id: assigned_ip.id)).order(:address)
               else
                 IpAddress.none
               end
      %>
      
      <%= select_tag "device[ip_address_ids][]",
            options_from_collection_for_select(ips, :id, :address, assigned_ip&.id),
            prompt: assigned_ip ? "Select IP..." : "Select Subnet First",
            class: "input w-full cursor-pointer" %>
    <% end %>
  </div>
</div>