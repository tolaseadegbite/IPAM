<div id="<%= dom_id device, :card %>" class="card flex flex-col gap-3 p-4">
  <div class="flex items-start justify-between gap-2">
    <div class="min-w-0">
      <div class="truncate text-lg leading-tight font-semibold"><%= link_to (device.name.presence || "—"), device, class: "text-orange-600 hover:underline dark:text-orange-400", data: { turbo_frame: "_top" } %></div>
      <span class="text-xs font-semibold tracking-wide text-zinc-500 uppercase dark:text-zinc-400"><%= device.device_type&.humanize.presence || "—" %></span>
    </div>

    <div class="flex shrink-0 flex-col items-end gap-1">
      <%
        status_badge = case device.status
          when "active" then "bg-green-100 text-green-800 dark:bg-green-500/15 dark:text-green-300"
          when "in_storage", "in_repair" then "bg-amber-100 text-amber-800 dark:bg-amber-500/15 dark:text-amber-300"
          when "retired", "lost" then "bg-red-100 text-red-800 dark:bg-red-500/15 dark:text-red-300"
          else "bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300"
          end
      %>
      <span class="<%= status_badge %> rounded-md px-2 py-0.5 text-xs font-medium"><%= device.status&.humanize || "—" %></span>
      <% if device.critical? %>
        <span class="rounded-md bg-orange-100 px-2 py-0.5 text-xs font-medium text-orange-800 dark:bg-orange-500/15 dark:text-orange-300">Critical</span>
      <% end %>
    </div>
  </div>

  <div class="flex items-start gap-2 rounded-lg border border-zinc-200 bg-zinc-50 p-2 dark:border-white/10 dark:bg-white/5">
    <%= icon("globe", "mt-0.5 h-4 w-4 shrink-0 text-zinc-400") %>
    <div class="flex min-w-0 flex-col gap-1">
      <% if device.ip_addresses.any? %>
        <% device.ip_addresses.each do |ip| %>
          <div class="flex items-center gap-1.5 font-mono text-sm">
            <%= link_to ip.address, ip, class: "truncate text-sky-600 hover:underline dark:text-sky-400", data: { turbo_frame: "_top" } %>
            <span class="h-1.5 w-1.5 shrink-0 rounded-full <%= ip.reachability_status_up? ? "bg-green-500" : "bg-red-500" %>"
                  title="<%= ip.reachability_status_up? ? "Online" : "Offline" %>"></span>
          </div>
        <% end %>
      <% else %>
        <span class="text-sm text-zinc-400 italic">No IP assigned</span>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-2 rounded-lg border border-zinc-200 bg-zinc-50 p-2 font-mono text-sm dark:border-white/10 dark:bg-white/5">
    <%= icon("monitor", "h-4 w-4 shrink-0 text-zinc-400") %>
    <% if device.mac_address %>
      <span class="truncate text-green-600 dark:text-green-400"><%= device.mac_address %></span>
    <% else %>
      <span class="text-zinc-400 italic">No MAC</span>
    <% end %>
  </div>

  <div class="flex items-center gap-3 border-t border-zinc-200 pt-3 dark:border-white/10">
    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-zinc-200 text-sm font-semibold dark:bg-zinc-700">
      <%= device.employee&.first_name&.first || "?" %>
    </span>
    <div class="flex min-w-0 flex-col text-sm">
      <span class="truncate font-semibold"><%= link_to device.employee&.full_name.presence || "Owner: —", device.employee, class: "hover:text-orange-500", data: { turbo_frame: "_top" } %></span>
      <span class="truncate text-xs text-zinc-500 dark:text-zinc-400">
        <% if device.department %>
          <%= device.department.branch.name %> (<%= device.department.name %>)
        <% else %>
          —
        <% end %>
      </span>
    </div>
  </div>

  <div class="flex items-center justify-end gap-4 text-xs">
    <%= link_to "Edit", edit_device_path(device), class: "font-medium text-zinc-500 hover:text-orange-500 dark:text-zinc-400", data: { turbo_frame: "modal" } %>
    <% delete_trigger = button_tag "Delete", type: "button", class: "cursor-pointer font-medium text-zinc-500 hover:text-red-500 dark:text-zinc-400", data: { action: "dialog#showModal" } %>
    <%= modal_dialog delete_trigger, size: "450px", title: "Delete '#{device.name}'?" do %>
      <p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">This will permanently delete this device. This action cannot be undone.</p>
      <div class="flex items-center justify-end gap-2">
        <button type="button" class="btn" data-action="click->dialog#close">Cancel</button>
        <%= button_to "Continue", device, method: :delete, class: "btn btn--negative" %>
      </div>
    <% end %>
  </div>
</div>
