<% content_for :title, "Asset Inventory" %>

<% content_for :page_header do %>Asset Inventory (<%= @pagy.count %>)<% end %>

<% content_for :header_action_buttons do %>
  <%= link_to "New Device", new_device_path, class: "btn btn--primary hidden !px-3 !py-1.5 text-sm md:inline-flex",
              data: { turbo_frame: "modal" } %>
<% end %>

<%= link_to new_device_path, class: "btn btn--primary fixed right-4 bottom-24 z-30 !rounded-full !p-4 shadow-lg md:hidden",
            data: { turbo_frame: "modal" }, aria: { label: "New device" } do %>
  <%= icon("plus", "h-5 w-5") %>
<% end %>

<%= render "search_form" %>

<%= turbo_frame_tag :devices_table do %>
  <div class="relative hidden overflow-x-auto rounded-xl border border-zinc-200 bg-white md:block dark:border-white/10 dark:bg-zinc-900">
    <table class="table w-full">
      <thead class="bg-zinc-50 dark:bg-white/5">
        <tr>
          <th class="p-3"><%= sort_link(@search, :name, "Device") %></th>
          <th class="p-3"><%= sort_link(@search, :ip_address_address, "IP Address") %></th>
          <th class="p-3"><%= sort_link(@search, :mac_address, "MAC") %></th>
          <th class="p-3"><%= sort_link(@search, :employee_full_name, "Assigned To") %></th>
          <th class="p-3"><%= sort_link(@search, :status, "Status") %></th>
          <th class="p-3"><%= sort_link(@search, :critical, "Critical?") %></th>
          <th class="p-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody id="devices-table">
        <% if @devices.empty? %>
          <tr><td colspan="7" class="p-8 text-center text-sm text-zinc-500 dark:text-zinc-400">No devices found.</td></tr>
        <% else %>
          <%= render @devices %>
        <% end %>
      </tbody>
    </table>
  </div>

  <div id="devices-cards" class="flex flex-col gap-4 md:hidden">
    <% if @devices.empty? %>
      <%= render "shared/empty_state", object: "device" %>
    <% else %>
      <%= render partial: "devices/device_card", collection: @devices, as: :device %>
    <% end %>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
<% end %>
