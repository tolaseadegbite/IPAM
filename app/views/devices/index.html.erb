<% content_for :title, "Asset Inventory" %>

<% content_for :page_header do %>Asset Inventory (<%= @pagy.count %>)<% end %>

<% content_for :header_action_buttons do %>
  <%= link_to "New Device", new_device_path, class: "btn btn--primary hidden !px-3 !py-1.5 text-sm md:inline-flex" %>
<% end %>

<%= link_to new_device_path, class: "btn btn--primary fixed right-4 bottom-24 z-30 !rounded-full !p-4 shadow-lg md:hidden",
            aria: { label: "New device" } do %>
  <%= icon("plus", "h-5 w-5") %>
<% end %>

<%= render "search_form" %>

<%= turbo_frame_tag :devices_table do %>
  <%
    # Reject blanks (cleared forms submit empty q values; sort links add
    # only q[s]) so the summary below reflects truly active filters.
    dq = params[:q]&.to_unsafe_h&.reject { |_, v| v.blank? } || {}
    without = ->(key) { devices_path(q: dq.except(key.to_s)) }
    device_pills = []
      device_pills << { label: "Keyword", value: dq["name_cont"], url: without.(:name_cont), names: "q[name_cont]" } if dq["name_cont"].present?
      if dq["department_branch_id_eq"].present? && (bname = Branch.find_by(id: dq["department_branch_id_eq"])&.name)
        device_pills << { label: "Branch", value: bname, url: without.(:department_branch_id_eq), names: "q[department_branch_id_eq]" }
      end
      device_pills << { label: "IP", value: dq["ip_addresses_address_string_cont"], url: without.(:ip_addresses_address_string_cont), names: "q[ip_addresses_address_string_cont]" } if dq["ip_addresses_address_string_cont"].present?
      device_pills << { label: "MAC", value: dq["mac_address_cont"], url: without.(:mac_address_cont), names: "q[mac_address_cont]" } if dq["mac_address_cont"].present?
      if dq["critical_eq"].present?
        device_pills << { label: "Critical", value: dq["critical_eq"] == "true" ? "Yes" : "No", url: without.(:critical_eq), names: "q[critical_eq]" }
      end
      if dq["device_type_eq"].present?
        device_pills << { label: "Type", value: Device.device_types.key(dq["device_type_eq"].to_i)&.humanize || dq["device_type_eq"], url: without.(:device_type_eq), names: "q[device_type_eq]" }
      end
      if dq["status_eq"].present?
        device_pills << { label: "Status", value: Device.statuses.key(dq["status_eq"].to_i)&.humanize || dq["status_eq"], url: without.(:status_eq), names: "q[status_eq]" }
      end
    %>
  <% if device_pills.any? %>
    <p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">Found <strong class="font-semibold text-zinc-900 dark:text-zinc-100"><%= @pagy.count %></strong> <%= "device".pluralize(@pagy.count) %> matching your filters.</p>
    <%= render "shared/active_filters", pills: device_pills, clear_url: devices_path %>
  <% end %>
  <div class="overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-white/10 dark:bg-zinc-900">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-zinc-200 px-4 py-2.5 dark:border-white/10">
      <span class="text-[13px] font-semibold tabular-nums"><%= @pagy.count %> devices</span>
      <div class="flex items-center gap-1 text-[13px]">
        <span class="font-medium text-zinc-500 dark:text-zinc-400">Sort:</span>
        <%= sort_link(@search, :name, "Name", class: "rounded-md px-2 py-1 font-semibold hover:underline") %>
        <%= sort_link(@search, :status, "Status", class: "rounded-md px-2 py-1 font-semibold hover:underline") %>
      </div>
    </div>
    <div id="devices-list" class="divide-y divide-zinc-200 dark:divide-white/10">
      <% if @devices.empty? %>
        <div class="p-4" data-controller="search-filter">
        <% if params.dig(:q, :critical_eq) == "true" %>
          <%= render "shared/empty_state", object: "device", title: "No critical devices",
                icon: "circle-check",
                description: "Nothing needs special watch.",
                action: link_to("View all devices", devices_path, class: "font-medium text-orange-600 hover:underline dark:text-orange-400",
                  data: { action: "click->search-filter#resetAll" }) %>
        <% else %>
          <%= render "shared/empty_state", object: "device" %>
        <% end %>
        </div>
      <% else %>
        <%= render partial: "devices/device", collection: @devices, as: :device %>
      <% end %>
    </div>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
<% end %>
