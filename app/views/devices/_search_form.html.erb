<div data-controller="search-filter" data-action="click@window->search-filter#closeOnClickOutside">
  <button type="button" class="btn mb-4" data-action="search-filter#toggle">
    <%= icon("search", "h-4 w-4") %>
    <span>Search &amp; Filter</span>
  </button>

  <div class="card mb-4 hidden p-4" data-search-filter-target="filters">
    <%= search_form_for @search,
        data: {
          turbo_frame: "devices_table",
          turbo_action: "advance",
          controller: "debounce"
        } do |f| %>
      <div class="grid grid-cols-1 items-end gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6">
        <div>
          <%= f.label :name_cont, "Keyword", class: "mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400" %>
          <%= f.search_field :name_cont, placeholder: "Search name", class: "input",
              data: { action: "input->debounce#submit" } %>
        </div>

        <div>
          <%= f.label :department_branch_id_eq, "Branch", class: "mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400" %>
          <%= f.collection_select :department_branch_id_eq, Branch.order(:name), :id, :name,
                { include_blank: "All Branches" },
                { class: "input cursor-pointer", data: { action: "input->debounce#submit" } } %>
        </div>

        <div>
          <%= f.label :ip_addresses_address_string_cont, "IP Address", class: "mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400" %>
          <%= f.search_field :ip_addresses_address_string_cont, placeholder: "192.168…", class: "input",
              data: { action: "input->debounce#submit" } %>
        </div>

        <div>
          <%= f.label :mac_address_cont, "MAC Address", class: "mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400" %>
          <%= f.search_field :mac_address_cont, placeholder: "AA:BB:CC…", class: "input",
              data: { action: "input->debounce#submit" } %>
        </div>

        <div>
          <%= f.label :critical_eq, "Critical device?", class: "mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400" %>
          <%= f.select :critical_eq, [["Yes", true], ["No", false]], { include_blank: "All" },
                { class: "input cursor-pointer", data: { action: "input->debounce#submit" } } %>
        </div>

        <div>
          <%= f.label :device_type_eq, "Type", class: "mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400" %>
          <%= f.select :device_type_eq, Device.device_types.map { |k, v| [k.humanize, v] },
                { include_blank: "All Types" },
                { class: "input cursor-pointer", data: { action: "input->debounce#submit" } } %>
        </div>

        <div>
          <%= f.label :status_eq, "Status", class: "mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400" %>
          <%= f.select :status_eq, Device.statuses.map { |k, v| [k.humanize, v] },
                { include_blank: "All Statuses" },
                { class: "input cursor-pointer", data: { action: "input->debounce#submit" } } %>
        </div>

        <div class="flex gap-2">
          <%= link_to "Clear", devices_path, class: "btn btn--secondary", data: { turbo_frame: "devices_table", action: "click->search-filter#clear" } %>
        </div>
      </div>
    <% end %>
  </div>
</div>
