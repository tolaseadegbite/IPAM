<%# Unified device row — the only device list item at every width.
    Locals: device. Lives in the divided list; secondary meta hides
    progressively (sm:, md:) instead of duplicating markup. %>
<%
  ips = device.ip_addresses.to_a
  reachable = ips.any?(&:reachability_status_up?)
  row_dot = if ips.empty?
              "bg-zinc-300 dark:bg-zinc-600"
            elsif reachable then "bg-green-500"
            else "bg-red-500"
            end
  status_color = case device.status
    when "active" then "bg-green-100 text-green-800 dark:bg-green-500/15 dark:text-green-300"
    when "in_storage", "in_repair" then "bg-amber-100 text-amber-800 dark:bg-amber-500/15 dark:text-amber-300"
    when "retired", "lost" then "bg-red-100 text-red-800 dark:bg-red-500/15 dark:text-red-300"
    else "bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300"
    end
%>
<div id="<%= dom_id(device) %>" class="flex min-h-16 items-center gap-3 px-4 py-3">
  <span class="h-2 w-2 shrink-0 rounded-full <%= row_dot %>"
        title="<%= ips.empty? ? "No IP assigned" : (reachable ? "Online" : "Offline") %>"></span>
  <span class="min-w-0 flex-1">
    <span class="block truncate text-[14.5px] font-semibold">
      <%= link_to (device.name.presence || "—"), device, class: "hover:text-orange-500", data: { turbo_frame: "_top" } %>
    </span>
    <span class="mt-0.5 block truncate text-[13px] text-zinc-500 dark:text-zinc-400">
      <span class="font-mono"><%= ips.first&.address || "Unassigned" %></span>
      <% if ips.size > 1 %><span class="tabular-nums"> (+<%= ips.size - 1 %>)</span><% end %>
      · <%= device.device_type&.humanize %>
    </span>
  </span>
  <span class="hidden shrink-0 font-mono text-[13px] text-green-600 sm:block dark:text-green-400">
    <%= device.mac_address.presence || "—" %>
  </span>
  <span class="hidden min-w-0 max-w-44 shrink-0 truncate text-[13px] text-zinc-500 md:block dark:text-zinc-400">
    <%= device.employee&.full_name || "Unassigned" %>
  </span>
  <%= render "shared/status_badge", color: status_color, label: device.status&.humanize || "—" %>
  <% if device.critical? %>
    <span class="hidden shrink-0 rounded-md bg-orange-100 px-2 py-0.5 text-xs font-medium text-orange-800 sm:block dark:bg-orange-500/15 dark:text-orange-300">Critical</span>
  <% end %>
  <span class="flex shrink-0 items-center">
    <%= render "shared/row_actions", record: device, show_path: device,
          edit_path: edit_device_path(device), delete_path: device,
          record_name: device.name, modal: false %>
  </span>
</div>
