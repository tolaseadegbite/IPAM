<%= turbo_frame_tag dom_id(device, :status) do %>
  <div class="flex items-center gap-4">
    <div>
      <label class="label-mono">Status</label>
      <div class="mt-1">
        <% color = device.active? ? "bg-green-100 text-green-800 dark:bg-green-500/15 dark:text-green-300" : "bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300" %>
        <span class="<%= color %> rounded-md px-3 py-0.5 text-sm font-bold uppercase"><%= device.status.humanize %></span>
      </div>
    </div>

    <div class="mt-4">
      <%= link_to edit_status_device_path(device), class: "text-zinc-400 hover:text-orange-500", title: "Change Status" do %>
        <%= icon("plus", "h-4 w-4") %>
      <% end %>
    </div>
  </div>
<% end %>
