<div id="<%= dom_id board %>" class="card flex flex-col justify-between p-4 transition hover:shadow-md">
  <div>
    <div class="mb-2 flex items-start justify-between gap-2">
      <h3 class="text-lg font-bold">
        <%= link_to board.name, board_path(board), class: "hover:text-orange-500", data: { turbo_frame: "_top" } %>
      </h3>
      <div class="flex shrink-0 items-center gap-3">
        <%= link_to edit_board_path(board), class: "text-zinc-400 hover:text-orange-500", data: { turbo_frame: "modal" }, aria: { label: "Edit board" } do %>
          <%= icon("pen", "h-4 w-4") %>
        <% end %>
        <% delete_trigger = button_tag "Delete", type: "button", class: "cursor-pointer text-xs font-medium text-zinc-400 hover:text-red-500", data: { action: "dialog#showModal" } %>
        <%= modal_dialog delete_trigger, size: "450px", title: "Delete '#{board.name}'?" do %>
          <p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">This will permanently delete this board and all its columns and tasks. This action cannot be undone.</p>
          <div class="flex items-center justify-end gap-2">
            <button type="button" class="btn" data-action="click->dialog#close">Cancel</button>
            <%= button_to "Continue", board, method: :delete, class: "btn btn--negative" %>
          </div>
        <% end %>
      </div>
    </div>
    <p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">
      <%= board.description.presence&.truncate(300) || "No description provided." %>
    </p>
  </div>

  <div class="flex items-center justify-between border-t border-zinc-200 pt-3 font-mono text-xs text-zinc-500 dark:border-white/10 dark:text-zinc-400">
    <span><%= board.lists.size %> columns</span>
    <span class="font-bold text-zinc-900 dark:text-zinc-100"><%= board.cards.count %> tasks</span>
  </div>
</div>
