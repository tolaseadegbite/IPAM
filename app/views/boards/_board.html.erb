<div id="<%= dom_id board %>" class="card p-4 flex flex-col justify-between hover:shadow-md transition">
  <div>
    <div class="flex justify-between items-start mbe-2">
      <h3 class="font-bold text-lg text-primary">
        <%= link_to board.name, board_path(board), class: "hover:text-orange-500", data: { turbo_frame: "_top" } %>
      </h3>
      
      <div class="flex gap-3 items-center">
        <%= link_to edit_board_path(board), class: "text-xs text-subtle hover:text-orange-500", data: { turbo_frame: "modal" } do %>
          <span class="icon icon--pen"></span>
        <% end %>

        <% delete_trigger = button_tag "Delete", type: "button", class: "text-xs text-subtle cursor-pointer hover:text-orange-600", data: { action: "dialog#showModal", menu_target: "item" }, role: "menuitem" %>
        <%= modal_dialog delete_trigger, size: "450px", title: "Delete '#{board.name}'?" do %>
            <p class="text-sm text-subtle mbe-4">This will permanently delete this branch. This action cannot be undone.</p>
            <div class="flex items-center justify-end gap">
                <button type="button" class="btn" data-action="click->dialog#close">Cancel</button>
                <%= button_to "Continue", board, method: :delete, class: "btn btn--negative" %>
            </div>
        <% end %>
      </div>
    </div>
    
    <p class="text-sm text-subtle mbe-4">
      <%= board.description.presence.truncate(300) || "No description provided." %>
    </p>
  </div>

  <div class="border-t border-main pbs-3 flex justify-between items-center text-xs text-subtle font-mono">
    <span><%= board.lists.size %> Columns</span>
    <span class="font-bold text-primary"><%= board.cards.count %> Tasks</span>
  </div>
</div>