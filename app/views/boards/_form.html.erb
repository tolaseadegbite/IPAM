<%= form_with(model: board, html: { contents: true }) do |form| %>
  <%= render "shared/error_messages", object: board %>

  <div class="mb-4">
    <%= form.label :name, "Board Name", class: "mb-1 block font-medium" %>
    <%= form.text_field :name, class: "input", placeholder: "e.g., Helpdesk" %>
  </div>

  <div class="mb-6">
    <%= form.label :description, class: "mb-1 block font-medium" %>
    <%= form.text_area :description, class: "input h-24", placeholder: "What is this board for?" %>
  </div>

  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <%= form.submit class: "btn btn--primary" %>
      <%= link_to "Cancel", "#", class: "text-sm text-zinc-500 hover:underline dark:text-zinc-400", data: { action: "click->modal#close" } %>
    </div>
    <% if board.persisted? %>
      <%= link_to "Delete Board", board_path(board), method: :delete, class: "text-xs text-red-500 hover:underline", data: { turbo_confirm: "Are you sure? This will delete all columns and tasks inside this board." } %>
    <% end %>
  </div>
<% end %>
