<% content_for :title, "Kanban Boards" %>

<% content_for :page_header do %>Operations Boards<% end %>

<% content_for :header_action_buttons do %>
  <%= link_to "New Board", new_board_path, class: "btn btn--primary !px-3 !py-1.5 text-sm", data: { turbo_frame: "modal" } %>
<% end %>

<div id="boards-grid" class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
  <%= render @boards %>
</div>

<% if @boards.empty? %>
  <div id="empty_state" class="mt-4 rounded-lg border border-dashed border-zinc-300 p-8 text-center text-sm text-zinc-500 italic dark:border-white/10 dark:text-zinc-400">
    No boards created yet. Click "New Board" to get started.
  </div>
<% end %>
