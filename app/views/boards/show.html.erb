<%= turbo_stream_from @board %>
<%= turbo_refreshes_with method: :morph, scroll: :preserve %>

<% content_for :title, @board.name %>

<% content_for :page_header do %><%= @board.name %><% end %>

<% content_for :header_action_buttons do %>
  <%= link_to new_board_list_path(@board), class: "btn btn--primary !px-3 !py-1.5 text-sm", data: { turbo_frame: "modal" } do %>
    <%= icon("plus", "h-4 w-4") %> New Column
  <% end %>
<% end %>

<div class="flex min-h-[50dvh] w-full flex-col gap-4">
  <div>
    <p class="text-sm text-zinc-500 dark:text-zinc-400"><%= simple_format(@board.description) %></p>
  </div>

  <%= render "search_form", board: @board, search: @search %>

  <div id="lists-container" class="flex h-full items-start gap-4 overflow-x-auto pb-4"
       data-controller="kanban-list"
       data-kanban-list-url-value="<%= move_list_path(":id") %>">
    <% @lists.each do |list| %>
      <%= render partial: "lists/list", locals: { list: list, cards: filtered_cards[list.id] || [] } %>
    <% end %>
  </div>
</div>
