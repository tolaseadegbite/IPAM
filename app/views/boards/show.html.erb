<% content_for :title, @board.name %>

<% content_for :page_header do %>
  Boards / <%= @board.name %>
<% end %>

<div class="p-4 b-full i-full overflow-hidden">

    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold"><%= @board.name %></h1>
        <div class="text-sm text-subtle"><%= @board.description %></div>
      </div>
      <button class="btn bg-orange-500 hover:bg-orange-600 btn--icon text-xs border-0 text-gray-50">
        <span class="icon icon--plus">+</span>
      </button>
    </div>
  
  <!-- BOARD CONTAINER: Horizontal Scroll -->
  <div class="flex gap-4 b-full overflow-x-auto pb-4 items-start">
    
    <%= render @board.lists %>

  </div>
</div>