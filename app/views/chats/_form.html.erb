<%= form_with(model: chat, url: chats_path, multipart: true) do |form| %>
  <div class="flex flex-col gap-4">
    <div>
      <%= form.label :model, "Select AI model:", class: "text-sm font-medium mbe-1" %>
        <%= form.select :model,
            options_for_select(@chat_models.map { |model| [model.label, model.id] }.unshift([default_model_display_name, nil]), @selected_model), {}, { class: "input cursor-pointer" } %>
    </div>

    <div>
      <%= form.label :prompt, "Your question:", class: "text-sm font-medium mbe-1" %>
        <%= form.text_area :prompt, placeholder: "Type a message or attach photos...", autofocus: true, class: "input" %>
    </div>

    <div class="flex gap-2 items-center">
      <%= label_tag :attachments, class: "btn text-xs cursor-pointer" do %>
        <%= file_field_tag :attachments, multiple: true, accept: "image/*", class: "hidden" %>
        Attach
      <% end %>
      <%= form.submit "Start new chat", class: "btn btn--primary" %>
    </div>
  </div>
<% end %>
