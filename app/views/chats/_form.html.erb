<%= form_with(model: chat, url: chats_path) do |form| %>
  <div class="flex flex-col gap-4">
    <div>
      <%= form.label :model, "Select AI model:", class: "mb-1 text-sm font-medium" %>
        <%= form.select :model,
            options_for_select(@chat_models.map { |model| [model.label, model.id] }.unshift([default_model_display_name, nil]), @selected_model), {}, { class: "input cursor-pointer" } %>
    </div>

    <div>
      <%= form.label :prompt, "Your question:", class: "mb-1 text-sm font-medium" %>
        <%= form.text_area :prompt, placeholder: "Type a message or attach photos...", autofocus: true, class: "input" %>
    </div>

    <div class="accordion">
      <details name="attachments">
        <summary class="btn w-full text-xs text-zinc-500 dark:text-zinc-400">
          Attach photos
        </summary>
        <div class="mt-2">
          <%= tag.div class: "dropzone", data: {
            controller: "dropzone",
            dropzone_param_name_value: "message[attachment_ids][]",
            dropzone_url_value: rails_direct_uploads_url,
            dropzone_accepted_files_value: "image/*,.csv,.xls,.xlsx",
            dropzone_max_files_value: 5,
            dropzone_max_filesize_value: 10
          } do %>
            <div class="dz-default dz-message flex flex-col items-center py-2">
              <span class="text-sm">Drop photos, CSVs, or Excel files or click to attach</span>
            </div>
          <% end %>
        </div>
      </details>
    </div>

    <div>
      <%= form.submit "Start new chat", class: "btn btn--primary w-full" %>
    </div>
  </div>
<% end %>
