<%= form_with(model: chat, url: chats_path) do |form| %>
  <div class="flex flex-col gap-2">
    <div>
      <%= form.label :model, "Select AI model:", class: "mb-1 text-sm font-medium" %>
        <%= form.select :model,
            options_for_select(@chat_models.map { |model| [model.label, model.id] }.unshift([default_model_display_name, nil]), @selected_model), {}, { class: "input cursor-pointer" } %>
    </div>

    <div>
      <%= form.text_area :prompt, placeholder: "Type a message or attach photos...", autofocus: true, class: "input" %>
    </div>

    <div class="flex items-end justify-between gap-2 pb-1">
      <div class="gap-2 flex items-center">
        <div class="flex w-fit items-center gap-1 self-start rounded-full bg-zinc-200 p-0.5 dark:bg-zinc-800" role="radiogroup" aria-label="Starting mode">
          <% [["Plan", "plan"], ["Build", "build"]].each do |label, key| %>
            <label class="cursor-pointer">
              <%= form.radio_button :mode, key, checked: key == "plan", class: "peer sr-only" %>
              <span class="block rounded-full px-3 py-1 text-xs font-semibold text-zinc-500 peer-checked:bg-orange-500 peer-checked:text-white peer-checked:shadow-sm dark:text-zinc-400"><%= label %></span>
            </label>
          <% end %>
        </div>
        <div class="flex items-center gap-2">
          <%= tag.div class: "flex items-center gap-1", data: {
            controller: "dropzone",
            dropzone_param_name_value: "message[attachment_ids][]",
            dropzone_url_value: rails_direct_uploads_url,
            dropzone_accepted_files_value: "image/*,.csv,.xls,.xlsx,.pdf",
            dropzone_max_files_value: 5,
            dropzone_max_filesize_value: 10
          } do %>
            <button type="button" class="btn btn--icon btn--plain border-0 !p-2 text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100"
                    data-action="click->dropzone#browse" title="Attach photos, CSVs, or Excel files" aria-label="Attach files">
              <%= icon("paperclip", "h-[18px] w-[18px]") %>
            </button>
          <% end %>
        </div>
      </div>
      <%= form.submit "Start new chat", class: "btn btn--primary" %>
    </div>
  </div>
<% end %>
