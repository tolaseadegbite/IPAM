<%= turbo_stream_from "chat_#{@chat.id}" %>

<% content_for :title, "NAT Assistant" %>

<% content_for :page_header do %>
  <span class="block truncate"><%= @chat.messages.order(:id).first&.content&.truncate(60) || "NAT Assistant" %></span>
<% end %>

<div class="flex w-full flex-col max-w-7xl mx-auto" style="height: calc(100dvh - 12rem);">
  <div id="messages" data-controller="autoscroll chat-history" class="mb-4 flex min-h-0 flex-1 flex-col gap-2 overflow-y-auto rounded-xl border border-zinc-200 bg-white p-3 sm:p-4 dark:border-white/10 dark:bg-zinc-900">
    <% if @has_older %>
      <div id="history_sentinel" data-chat-history-target="sentinel" data-oldest-id="<%= @recent_messages.first.id %>" class="p-2 text-center text-xs text-zinc-500 dark:text-zinc-400">
        <span class="animate-pulse">Loading older messages…</span>
      </div>
    <% end %>
    <% @recent_messages.each do |message| %>
      <%= render message %>
    <% end %>
    <% if @chat.messages.exists?(role: :user) %>
      <% last_assistant = @chat.messages.where(role: :assistant).order(:id).last %>
      <% if last_assistant.nil? || last_assistant.content.blank? %>
        <%= render "messages/assistant_skeleton", skeleton_id: "message_skeleton_#{@chat.id}" %>
      <% end %>
    <% end %>
  </div>

  <div class="mt-auto">
    <%= render "messages/form", chat: @chat, message: @message %>
  </div>
</div>
