<%= turbo_stream_from "chat_#{@chat.id}" %>

<% content_for :title, "NAT Assistant" %>

<% content_for :page_header do %>
  <h4 class="font-semibold truncate"><%= @chat.messages.order(:id).first&.content&.truncate(60) || "NAT Assistant" %></h4>
<% end %>

<div class="p-4 i-full flex flex-col" style="height: calc(100dvh - 4rem);">

  <div id="messages" data-controller="autoscroll" class="flex flex-col gap-2 flex-1 overflow-y-auto p-4 border rounded-lg bg-elevated mbe-4">
    <% @chat.messages.where.not(id: nil).each do |message| %>
      <%= render message %>
    <% end %>
    <% if @chat.messages.exists?(role: :user) %>
      <% last_assistant = @chat.messages.where(role: :assistant).order(:id).last %>
      <% if last_assistant.nil? || last_assistant.content.blank? %>
        <%= render "messages/assistant_skeleton", skeleton_id: "message_skeleton_#{@chat.id}" %>
      <% end %>
    <% end %>
  </div>

  <div class="mbs-auto">
    <%= render "messages/form", chat: @chat, message: @message %>
  </div>
</div>
