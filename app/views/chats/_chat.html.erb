<div id="<%= dom_id chat %>" class="card flex flex-col gap-1 p-3 transition hover:border-orange-300 dark:hover:border-orange-500/40">
  <%= link_to chat_path(chat) do %>
    <div class="truncate text-sm font-semibold">
      <%= chat.messages.reject { |m| %w[system tool].include?(m.role) }.first&.content&.truncate(80) || "New conversation" %>
    </div>
    <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-zinc-500 dark:text-zinc-400">
      <span><%= chat.user.username.presence || chat.user.email.truncate(24) %></span>
      <span><%= chat.model&.label || "Default model" %></span>
      <span><%= pluralize(chat.messages.size, "message") %></span>
      <span><%= time_ago_in_words(chat.updated_at) %> ago</span>
    </div>
  <% end %>
</div>
