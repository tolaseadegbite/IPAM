<%= form_with(model: subnet, html: { contents: true }) do |form| %>
  <%= render "shared/error_messages", object: subnet %>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div class="col-span-1">
      <%= form.label :name, "Subnet Name", class: "mb-1 block font-medium" %>
      <%= form.text_field :name, class: "input", placeholder: "e.g., Corporate Data" %>
    </div>
    
    <div class="col-span-1">
      <%= form.label :network_address, "CIDR Range", class: "mb-1 block font-medium" %>
      
      <% if subnet.persisted? %>
        <%# READ-ONLY MODE %>
        <%= form.text_field :network_address, 
              value: subnet.network_address_before_type_cast, 
              class: "input cursor-not-allowed bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400", 
              readonly: true,
              title: "Delete and recreate this subnet to change the range." %>
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Cannot be changed after creation.</p>
      <% else %>
        <%# EDIT MODE %>
        <%= form.text_field :network_address, 
              value: subnet.network_address_before_type_cast, 
              class: "input", 
              placeholder: "e.g., 192.168.13.0/24" %>
      <% end %>
    </div>

    <div class="col-span-1">
      <%= form.label :gateway, class: "mb-1 block font-medium" %>
      <%= form.text_field :gateway, class: "input", placeholder: "e.g., 192.168.13.1" %>
    </div>
    <div class="col-span-1">
      <%= form.label :vlan_id, "VLAN ID", class: "mb-1 block font-medium" %>
      <%= form.number_field :vlan_id, class: "input" %>
    </div>
  </div>

  <div class="mt-4 flex items-center gap-3">
    <%= form.submit "Save Subnet", class: "btn btn--primary" %>
    <%= link_to "Cancel", subnets_path, class: "text-sm text-zinc-500 hover:underline dark:text-zinc-400", data: { turbo_frame: "_top" } %>
  </div>
<% end %>