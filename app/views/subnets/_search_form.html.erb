<%= render "shared/search_panel" do %>
    <%= search_form_for @search,
        data: {
          controller: "debounce",
          turbo_frame: "subnets_table",
          turbo_action: "advance",
          action: "input->debounce#submit change->debounce#submit"
        } do |f| %>
      <div class="grid grid-cols-1 items-end gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div>
          <%= f.label :name_cont, "Subnet Name", class: "mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400" %>
          <%= f.search_field :name_cont, placeholder: "Search…", class: "input" %>
        </div>
        <div>
          <%= f.label :vlan_id_eq, "VLAN", class: "mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400" %>
          <%= f.collection_select :vlan_id_eq, Subnet.where.not(vlan_id: nil).distinct.order(:vlan_id), :vlan_id, :vlan_id,
                { include_blank: "All VLANs" },
                { class: "input cursor-pointer" } %>
        </div>
        <div class="flex gap-2">
          <%= link_to "Clear", subnets_path, class: "btn btn--primary", data: { action: "click->search-filter#resetAll" } %>
        </div>
      </div>
    <% end %>
<% end %>
