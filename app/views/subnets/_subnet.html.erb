<%# Unified subnet row — the only subnet list item at every width.
    Locals: subnet. %>
<div id="<%= dom_id(subnet) %>" class="flex min-h-16 items-center gap-3 px-4 py-3">
  <span class="min-w-0 flex-1">
    <span class="block truncate text-[14.5px] font-semibold">
      <%= link_to subnet.name, subnet, class: "hover:text-orange-500", data: { turbo_frame: "_top" } %>
    </span>
    <span class="mt-0.5 block truncate font-mono text-[13px] text-sky-600 dark:text-sky-400">
      <%= subnet.network_address %>
      <span class="text-zinc-500 dark:text-zinc-400">· gw <%= subnet.gateway %></span>
    </span>
  </span>
  <% if subnet.vlan_id.present? %>
    <span class="hidden shrink-0 rounded-md border border-zinc-200 bg-zinc-100 px-2 py-0.5 font-mono text-xs sm:block dark:border-white/10 dark:bg-zinc-800">
      VLAN <%= subnet.vlan_id %>
    </span>
  <% end %>
  <span class="hidden shrink-0 text-[13px] text-zinc-500 tabular-nums md:block dark:text-zinc-400">
    <%= subnet.ip_addresses_count %> IPs
  </span>
  <span class="flex shrink-0 items-center">
    <%= render "shared/row_actions", record: subnet, show_path: subnet,
          edit_path: edit_subnet_path(subnet), delete_path: subnet,
          record_name: subnet.name %>
  </span>
</div>
