<% content_for :title, @subnet.name %>

<% content_for :page_header do %><%= @subnet.name %><% end %>

<% content_for :header_action_buttons do %>
  <div class="hidden items-center gap-2 md:flex">
    <%= link_to "Edit", edit_subnet_path(@subnet), class: "btn btn--primary !px-3 !py-1.5 text-sm", data: { turbo_frame: "modal" } %>
    <% delete_trigger = button_tag "Delete", type: "button", class: "btn !border-red-200 !px-3 !py-1.5 text-sm !text-red-600 hover:!bg-red-50 dark:!border-red-500/30 dark:!text-red-400 dark:hover:!bg-red-500/10", data: { action: "dialog#showModal" } %>
    <%= modal_dialog delete_trigger, size: "450px", title: "Delete '#{@subnet.name}'?" do %>
      <p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">This will permanently delete this subnet. This action cannot be undone.</p>
      <div class="flex items-center justify-end gap-2">
        <button type="button" class="btn" data-action="click->dialog#requestClose">Cancel</button>
        <%= button_to "Continue", @subnet, method: :delete, data: { turbo: false }, class: "btn btn--negative" %>
      </div>
    <% end %>
  </div>
<% end %>

<%= link_to edit_subnet_path(@subnet), class: "btn btn--primary fixed right-4 bottom-24 z-30 !rounded-full !p-4 shadow-lg md:hidden",
            data: { turbo_frame: "modal" }, aria: { label: "Edit subnet" } do %>
  <%= icon("square-pen", "h-5 w-5") %>
<% end %>

<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <div class="flex flex-col gap-3">
    <nav class="flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <%= link_to "Subnets", subnets_path, class: "hover:text-orange-500", data: { turbo_frame: "_top" } %>
      <span aria-hidden="true">/</span>
      <span class="truncate font-medium text-zinc-900 dark:text-zinc-100"><%= @subnet.name %></span>
    </nav>
    <div class="flex items-center gap-3">
      <%= link_to :back, class: "btn shrink-0 !p-2", aria: { label: "Back" } do %>
        <%= icon("chevron-left", "h-4 w-4") %>
      <% end %>
      <div class="min-w-0 flex-1">
        <h1 class="truncate text-2xl font-bold tracking-tight sm:text-3xl"><%= @subnet.name %></h1>
        <div class="mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
          <span class="font-mono text-orange-600 dark:text-orange-400"><%= @subnet.network_address %></span>
          <% if @subnet.branch.present? %>
            <%= link_to @subnet.branch.name, @subnet.branch, class: "hover:text-orange-500", data: { turbo_frame: "_top" } %>
          <% else %>
            <span class="text-xs text-zinc-500 italic dark:text-zinc-400">Unassigned branch</span>
          <% end %>
          <% if @subnet.vlan_id.present? %>
            <span class="rounded-md border border-zinc-200 bg-zinc-100 px-1.5 py-0.5 font-mono text-xs dark:border-white/10 dark:bg-zinc-800">VLAN <%= @subnet.vlan_id %></span>
          <% end %>
          <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400">gw <%= @subnet.gateway %></span>
        </div>
      </div>
    </div>
  </div>

  <%
    total = @subnet.ip_addresses.count
    used = @subnet.ip_addresses.where.not(device_id: nil).count
    percent = total > 0 ? ((used.to_f / total) * 100).round : 0
  %>
  <div class="card p-4">
    <div class="mb-2 flex flex-wrap items-end justify-between gap-2">
      <span class="label-mono !text-xs">Utilization</span>
      <span class="text-lg font-semibold tabular-nums"><%= used %> / <%= total %> IPs used (<%= percent %>%)</span>
    </div>
    <div class="h-2.5 w-full overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-700" role="progressbar"
         aria-valuenow="<%= percent %>" aria-valuemin="0" aria-valuemax="100" aria-label="Subnet utilization">
      <div class="h-full rounded-full <%= percent > 90 ? "bg-red-500" : percent > 70 ? "bg-amber-400" : "bg-green-500" %>"
           style="width: <%= percent %>%;"></div>
    </div>
  </div>

  <div class="card p-4">
    <h3 class="mb-4 text-lg font-bold">IP Address Pool</h3>
    <%# Controls live OUTSIDE the results frame so debounce resubmits
        never replace the focused input (focus-loss fix). %>
    <div class="mb-4 flex flex-wrap items-center gap-2">
      <div class="flex rounded-lg border border-zinc-200 p-0.5 text-sm dark:border-white/10">
        <% [["All", nil], ["Assigned", "assigned"], ["Free", "free"]].each do |label, value| %>
          <% active = params[:pool].to_s == value.to_s %>
          <%= link_to label, subnet_path(@subnet, pool: value, addr: params[:addr]),
                data: { turbo_frame: "ip_pool" },
                class: "rounded-md px-3 py-1 font-medium #{active ? "bg-zinc-900 text-white dark:bg-zinc-100 dark:text-zinc-900" : "text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"}" %>
        <% end %>
      </div>
      <%= form_with url: subnet_path(@subnet), method: :get,
            data: { turbo_frame: "ip_pool", controller: "debounce", action: "input->debounce#submit change->debounce#submit" },
            class: "min-w-44 flex-1" do %>
        <%= hidden_field_tag :pool, params[:pool] %>
        <%= search_field_tag :addr, params[:addr], placeholder: "Filter by address…",
              class: "input" %>
      <% end %>
    </div>
    <%= turbo_frame_tag "ip_pool" do %>
      <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-4 lg:grid-cols-6">
        <% @pool_ips.each do |ip| %>
        <%
          bg_class = if ip.active?
                       "border-red-200 bg-red-50 text-red-800 hover:shadow-md dark:border-red-500/20 dark:bg-red-500/10 dark:text-red-200"
                     elsif ip.reserved?
                       "border-amber-200 bg-amber-50 text-amber-800 hover:shadow-md dark:border-amber-500/20 dark:bg-amber-500/10 dark:text-amber-200"
                     else
                       "border-green-200 bg-green-50 text-green-800 hover:shadow-md dark:border-green-500/20 dark:bg-green-500/10 dark:text-green-200"
                     end
        %>
        <%= link_to edit_ip_address_path(ip), class: "rounded-lg border p-2 text-center transition #{bg_class}", data: { turbo_frame: "modal" } do %>
          <div class="font-mono text-sm font-bold"><%= ip.address.to_s.split(".").last %></div>
          <div class="truncate text-xs opacity-75">
            <%= ip.device ? ip.device.name : ip.status %>
          </div>
        <% end %>
      <% end %>
      </div>
      <div class="mt-4">
        <%= render "shared/pagination", pagy: @pagy %>
      </div>
    <% end %>
  </div>

  <div>
    <%
      subnet_versions = @subnet.versions.order(created_at: :desc).limit(20)
    %>
    <%= render "shared/audit_log", records: subnet_versions, parent: @subnet %>
  </div>
</div>
