<% content_for :title, "Network Subnets" %>

<% content_for :page_header do %>Network Subnets (<%= @pagy.count %>)<% end %>

<% content_for :header_action_buttons do %>
  <%= link_to "Add Subnet", new_subnet_path, class: "btn btn--primary hidden !px-3 !py-1.5 text-sm md:inline-flex",
              data: { turbo_frame: "modal" } %>
<% end %>

<%= link_to new_subnet_path, class: "btn btn--primary fixed right-4 bottom-24 z-30 !rounded-full !p-4 shadow-lg md:hidden",
            data: { turbo_frame: "modal" }, aria: { label: "Add subnet" } do %>
  <%= icon("plus", "h-5 w-5") %>
<% end %>

<%= turbo_frame_tag :subnets_table do %>
  <div class="relative hidden overflow-x-auto rounded-xl border border-zinc-200 bg-white md:block dark:border-white/10 dark:bg-zinc-900">
    <table class="table w-full">
      <thead class="bg-zinc-50 dark:bg-white/5">
        <tr>
          <th class="p-3"><%= sort_link(@search, :name, "Subnet") %></th>
          <th class="p-3"><%= sort_link(@search, :network_address, "Network / CIDR") %></th>
          <th class="p-3"><%= sort_link(@search, :gateway, "Gateway") %></th>
          <th class="p-3"><%= sort_link(@search, :vlan_id, "VLAN") %></th>
          <th class="p-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody id="subnets-table">
        <% if @subnets.empty? %>
          <tr><td colspan="5" class="p-8 text-center text-sm text-zinc-500 dark:text-zinc-400">No subnets found.</td></tr>
        <% else %>
          <%= render @subnets %>
        <% end %>
      </tbody>
    </table>
  </div>

  <div id="subnets-cards" class="flex flex-col gap-4 md:hidden">
    <% if @subnets.empty? %>
      <%= render "shared/empty_state", object: "subnet" %>
    <% else %>
      <%= render partial: "subnets/subnet_card", collection: @subnets, as: :subnet %>
    <% end %>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
<% end %>
