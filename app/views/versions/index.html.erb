<% content_for :title, "Audit History" %>

<% content_for :page_header do %>
  <span class="flex items-center gap-3">
    <% if @item %>
      <%= link_to polymorphic_path(@item), class: "btn shrink-0 !p-2", aria: { label: "Back" } do %>
        <%= icon("chevron-left", "h-4 w-4") %>
      <% end %>
      <span class="truncate">History: <%= @item.try(:name) || @item.try(:full_name) || "Item ##{@item.id}" %> (<%= @pagy.count %>)</span>
    <% else %>
      Global Audit Log (<%= @pagy.count %>)
    <% end %>
  </span>
<% end %>

<div class="flex w-full flex-col gap-4">
  <%= render "shared/audit_log", records: @versions, hide_footer: true %>

  <div class="border-t border-zinc-200 p-4 dark:border-white/10">
    <%= render "shared/pagination", pagy: @pagy %>
  </div>
</div>
