<%= render "shared/search_panel" do %>
    <%# ADD 'turbo_frame: "ip_addresses"' BACK %>
    <%= search_form_for @search, 
        data: { 
          turbo_frame: "ip_addresses", 
          turbo_action: "advance",
          controller: "debounce",
          action: "input->debounce#submit change->debounce#submit" 
        } do |f| %>
      
      <div class="grid grid-cols-1 items-center gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        
        <%# 1. IP Search %>
        <div>
          <%= f.label :address_string_cont, "IP Address", class: "mb-1 block text-xs font-bold uppercase tracking-wide text-zinc-500 dark:text-zinc-400" %>
          <%= f.search_field :address_string_cont, 
              placeholder: "192.168...", 
              class: "input cursor-pointer" %>
        </div>

        <%# 2. Subnet Filter %>
        <div>
          <%= f.label :subnet_id_eq, "Subnet", class: "mb-1 block text-xs font-bold uppercase tracking-wide text-zinc-500 dark:text-zinc-400" %>
          <%= f.collection_select :subnet_id_eq, Subnet.order(:name), :id, :name, 
                { include_blank: "All Subnets" }, 
                { class: "input cursor-pointer" } %>
        </div>

        <%# --- DEPENDENT DROPDOWNS (Branch -> Department) --- %>
        <div class="contents" 
             data-controller="dependent-select"
             data-dependent-select-url-value="<%= select_options_departments_path(
                 field_name: 'q[device_department_id_eq]', 
                 frame_id: 'search_dept_options',
                 data_action: 'input->debounce#submit'
               ) %>"
             data-dependent-select-param-value="branch_id"
             data-dependent-select-frame-id-value="search_dept_options">

          <%# 3. Branch Filter %>
          <div>
            <%= f.label :device_department_branch_id_eq, "Branch", class: "mb-1 block text-xs font-bold uppercase tracking-wide text-zinc-500 dark:text-zinc-400" %>
            <%= f.collection_select :device_department_branch_id_eq, Branch.order(:name), :id, :name, 
                  { include_blank: "All Branches" }, 
                  { 
                    class: "input cursor-pointer", 
                    data: { 
                      dependent_select_target: "select", 
                      action: "change->dependent-select#load input->debounce#submit" 
                    } 
                  } %>
          </div>

          <%# 4. Department Filter %>
          <div>
            <%= f.label :device_department_id_eq, "Department", class: "mb-1 block text-xs font-bold uppercase tracking-wide text-zinc-500 dark:text-zinc-400" %>
            
            <%= turbo_frame_tag "search_dept_options" do %>
              <% 
                 # Logic: If a branch is selected in search params, pre-load its departments
                 selected_branch = params.dig(:q, :device_department_branch_id_eq)
                 depts = selected_branch.present? ? Department.where(branch_id: selected_branch).order(:name) : []
              %>
              
              <%= f.collection_select :device_department_id_eq, depts, :id, :name,
                    { include_blank: selected_branch.present? ? "All Departments" : "Select Branch First" }, 
                    { 
                      class: "input cursor-pointer", 
                      disabled: depts.empty? 
                    } %>
            <% end %>
          </div>
        </div>

        <%# 5. Status Filter %>
        <div>
          <%= f.label :status_eq, "Status", class: "mb-1 block text-xs font-bold uppercase tracking-wide text-zinc-500 dark:text-zinc-400" %>
          <%= f.select :status_eq, IpAddress.statuses.map { |k, v| [k.humanize, v] }, 
                { include_blank: "All Statuses" }, 
                { class: "input cursor-pointer" } %>
        </div>

        <%# 6. Reachability Status Filter %>
        <div>
          <%= f.label :reachability_status_eq, "Reachability Status", class: "mb-1 block text-xs font-bold uppercase tracking-wide text-zinc-500 dark:text-zinc-400" %>
          <%= f.select :reachability_status_eq, IpAddress.reachability_statuses.map { |k, v| [k.humanize, v] }, 
                { include_blank: "Select Reachability status" }, 
                { class: "input cursor-pointer" } %>
        </div>

        <%# 7. Rogue Filter %>  
        <div>
          <label class="mb-1 block text-xs font-bold uppercase tracking-wide text-zinc-500 dark:text-zinc-400">Security Filter</label>

          <div class="flex items-center justify-between gap-2 rounded-lg border border-zinc-300 bg-white px-3 py-2 dark:border-white/10 dark:bg-zinc-900">
            <%= f.label :rogue_only, "Rogue devices?", class: "text-sm font-medium me-2 cursor-pointer" %>
            <%= f.check_box :rogue_only, 
                  class: "switch cursor-pointer", 
                  role: "switch",
                  checked: params.dig(:q, :rogue_only) == "true" || @search.rogue_only == true,
                  include_hidden: false
            %>
          </div>
        </div>

        <%# 8. Actions %>
        <div class="flex gap-2">
          <%#= f.submit "Filter", class: "btn btn--primary w-full",
                data: { action: "click->search-filter#preventClose" } %>
          
          <%= link_to "Clear", ip_addresses_path,
                class: "btn btn--primary",
                data: { action: "click->search-filter#resetAll" } %>
        </div>
      </div>
    <% end %>
<% end %>
