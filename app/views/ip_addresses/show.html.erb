<% content_for :title, @ip_address.address %>

<% content_for :page_header do %><span class="font-mono"><%= @ip_address.address %></span><% end %>

<% content_for :header_action_buttons do %>
  <div class="hidden items-center gap-2 md:flex">
    <%= link_to "Edit IP", edit_ip_address_path(@ip_address), class: "btn btn--primary !px-3 !py-1.5 text-sm",
                data: { turbo_frame: "modal" } %>
    <%= link_to new_card_path(referenceable_type: "IpAddress", referenceable_id: @ip_address.id),
                class: "btn !px-3 !py-1.5 text-sm", data: { turbo_frame: "modal" } do %>
      Investigate IP
    <% end %>
  </div>
<% end %>

<%= link_to edit_ip_address_path(@ip_address), class: "btn btn--primary fixed right-4 bottom-24 z-30 !rounded-full !p-4 shadow-lg md:hidden",
            data: { turbo_frame: "modal" }, aria: { label: "Edit IP" } do %>
  <%= icon("square-pen", "h-5 w-5") %>
<% end %>

<div class="mx-auto flex w-full max-w-2xl flex-col gap-4">
  <div class="flex flex-col gap-3">
    <nav class="flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <%= link_to "IP Addresses", ip_addresses_path, class: "hover:text-orange-500", data: { turbo_frame: "_top" } %>
      <span aria-hidden="true">/</span>
      <span class="font-mono font-medium text-zinc-900 dark:text-zinc-100"><%= @ip_address.address %></span>
    </nav>
    <div class="card flex flex-wrap items-center gap-x-4 gap-y-2 p-4">
      <% if @ip_address.reachability_status_up? %>
        <span class="flex items-center gap-1.5 rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-bold uppercase dark:bg-green-500/15 dark:text-green-300">
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-500"></span> Online
        </span>
      <% else %>
        <span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-bold uppercase dark:bg-zinc-800 dark:text-zinc-300">Offline</span>
      <% end %>
      <span class="font-mono text-xl font-bold"><%= @ip_address.address %></span>
      <span class="text-sm text-zinc-500 dark:text-zinc-400"><%= link_to @ip_address.subnet.name, @ip_address.subnet, class: "hover:text-orange-500", data: { turbo_frame: "_top" } %></span>
    </div>
  </div>

  <div id="details">
    <%= render "ip_addresses/details" %>
  </div>

  <%= render "cards/history", cards: @cards, parent: @ip_address %>

  <%
    ip_versions = @ip_address.versions.order(created_at: :desc).limit(20)
  %>
  <%= render "shared/audit_log", records: ip_versions, parent: @ip_address %>
</div>
