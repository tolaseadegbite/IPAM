<% content_for :title, "Ip Addresses" %>
<%= turbo_stream_from "monitoring" %>

<% content_for :page_header do %>
  <h4 class="font-semibold">
    Ip Address Management 
    <span id="ip_addresses_count" class="text-subtle text-sm font-normal">
      (<%= @pagy.count %>)
    </span>
  </h4>
<% end %>

<div class="p-4 i-full">
  <%= render "search_form" %>

  <%= turbo_frame_tag "ip_addresses" do %>
    
    <!-- 1. THE GRID -->
    <div class="grid grid-cols-1 grid-cols-2@sm grid-cols-3@md grid-cols-4@lg gap-4">
      <%= render @ip_addresses %>
    </div>
    
    <!-- 2. THE MAGIC FIX: OOB (Out-of-Band) Update -->
    <!-- This stream fires automatically when this frame loads -->
    <%= turbo_stream.update "ip_addresses_count" do %>
      (<%= @pagy.count %>)
    <% end %>

    <!-- 3. Update Pagination too (if it's outside the frame in your layout) -->
    <!-- If pagination is inside this frame, you don't need this stream. -->
    <%= turbo_stream.replace "pagination" do %>
      <div id="pagination">
        <%= render "shared/pagination", pagy: @pagy %>
      </div>
    <% end %>

  <% end %>

  <!-- Pagination Placeholder -->
  <div id="pagination">
    <%= render "shared/pagination", pagy: @pagy %>
  </div>
</div>