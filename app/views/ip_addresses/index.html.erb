<% content_for :title, "IP Addresses" %>
<%= turbo_stream_from "monitoring" %>

<% content_for :page_header do %>IP Addresses <span id="ip_addresses_count" class="text-sm font-normal text-zinc-500 dark:text-zinc-400">(<%= @pagy.count %>)</span><% end %>

<%= render "search_form" %>

<%= turbo_frame_tag "ip_addresses" do %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    <%= render @ip_addresses %>
  </div>

  <%= turbo_stream.update "ip_addresses_count" do %>
    (<%= @pagy.count %>)
  <% end %>

  <%= turbo_stream.replace "pagination" do %>
    <div id="pagination">
      <%= render "shared/pagination", pagy: @pagy %>
    </div>
  <% end %>
<% end %>

<div id="pagination">
  <%= render "shared/pagination", pagy: @pagy %>
</div>
