<%# Use the frame_id passed from the URL params, or fallback to a default %>
<%= turbo_frame_tag params[:frame_id] || "ip_address_options_frame" do %>
  <%= select_tag params[:field_name] || "device[ip_address_ids][]", 
        options_from_collection_for_select(ip_addresses, :id, :address),
        prompt: "Select Available IP",
        class: "input cursor-pointer" %>
<% end %>