<div id="<%= dom_id ip_address %>" class="card relative flex flex-col justify-between overflow-hidden p-4">
  <div class="flex items-start justify-between gap-2">
    <div class="min-w-0">
      <div class="truncate font-mono text-sm font-bold">
        <%= link_to ip_address.address, ip_address, class: "hover:text-orange-500", data: { turbo_frame: "_top" } %>
      </div>
      <div class="truncate text-xs text-zinc-500 dark:text-zinc-400"><%= ip_address.subnet.name %></div>
    </div>

    <% if ip_address.reachability_status_up? %>
      <span class="flex h-10 items-center" title="Online now">
        <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-green-500"></span>
      </span>
    <% elsif ip_address.reachability_status_down? && ip_address.last_seen_at %>
      <span class="shrink-0 text-right text-xs text-zinc-500 dark:text-zinc-400" title="<%= ip_address.last_seen_at.strftime("%b %d, %Y %H:%M") %>">
        <%= time_ago_in_words(ip_address.last_seen_at, include_seconds: false) %>
      </span>
    <% else %>
      <span class="flex h-10 items-center" title="Unknown">
        <span class="h-2.5 w-2.5 rounded-full bg-zinc-300 dark:bg-zinc-600"></span>
      </span>
    <% end %>
  </div>

  <div class="mt-3">
    <% if ip_address.device %>
      <div class="flex items-center gap-2">
        <%= icon("monitor", "h-4 w-4 shrink-0 text-zinc-400") %>
        <div class="truncate text-sm font-medium"><%= link_to ip_address.device.name, device_path(ip_address.device), data: { turbo_frame: "_top" } %></div>
      </div>
      <div class="ms-6 truncate text-xs text-zinc-500 dark:text-zinc-400"><%= ip_address.device.employee&.first_name || "Unassigned to an employee" %></div>
    <% else %>
      <div class="flex h-10 items-center text-xs text-zinc-400 italic">Empty slot</div>
    <% end %>
  </div>

  <div class="mt-3 flex items-center justify-between border-t border-zinc-200 pt-2 dark:border-white/10">
    <% status_color = case ip_address.status
       when "available" then "text-green-600 dark:text-green-400"
       when "active" then "text-sky-600 dark:text-sky-400"
       when "reserved" then "text-amber-600 dark:text-amber-400"
       when "blacklisted" then "text-red-600 dark:text-red-400"
       end %>
    <span class="font-mono text-xs font-semibold uppercase <%= status_color %>">
      <%= ip_address.status %>
    </span>
    <%= link_to "Edit", edit_ip_address_path(ip_address),
                class: "text-xs font-semibold text-zinc-500 hover:text-orange-500 dark:text-zinc-400",
                data: { turbo_frame: "modal" } %>
  </div>
</div>
