<%# Unified branch row — the only branch list item at every width.
    Locals: branch. %>
<div id="<%= dom_id(branch) %>" class="flex min-h-16 items-center gap-3 px-4 py-3">
  <span class="min-w-0 flex-1">
    <span class="block truncate text-[14.5px] font-semibold">
      <%= link_to branch.name, branch, class: "hover:text-orange-500", data: { turbo_frame: "_top" } %>
    </span>
    <span class="mt-0.5 block truncate text-[13px] text-zinc-500 dark:text-zinc-400">
      <%= branch.location.presence || "—" %>
      <% if branch.contact_phone.present? %>
        <span class="font-mono"> · <%= branch.contact_phone %></span>
      <% end %>
    </span>
  </span>
  <span class="flex shrink-0 items-center">
    <%= render "shared/row_actions", record: branch, show_path: branch,
          edit_path: edit_branch_path(branch), delete_path: branch, record_name: branch.name %>
  </span>
</div>
