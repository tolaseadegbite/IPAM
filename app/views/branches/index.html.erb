<% content_for :title, "Branches" %>

<% content_for :page_header do %>Branches (<%= @pagy.count %>)<% end %>

<% content_for :header_action_buttons do %>
  <%= link_to "New Branch", new_branch_path, class: "btn btn--primary hidden !px-3 !py-1.5 text-sm md:inline-flex",
              data: { turbo_frame: "modal" } %>
<% end %>

<%= link_to new_branch_path, class: "btn btn--primary fixed right-4 bottom-24 z-30 !rounded-full !p-4 shadow-lg md:hidden",
            data: { turbo_frame: "modal" }, aria: { label: "New branch" } do %>
  <%= icon("plus", "h-5 w-5") %>
<% end %>

<%= turbo_frame_tag :branches_table do %>
  <div class="relative hidden overflow-x-auto rounded-xl border border-zinc-200 bg-white md:block dark:border-white/10 dark:bg-zinc-900">
    <table class="table w-full">
      <thead class="bg-zinc-50 dark:bg-white/5">
        <tr>
          <th class="p-3"><%= sort_link(@search, :name, "Branch") %></th>
          <th class="p-3"><%= sort_link(@search, :location, "Location") %></th>
          <th class="p-3"><%= sort_link(@search, :contact_phone, "Phone") %></th>
          <th class="p-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody id="branches-table">
        <% if @branches.empty? %>
          <tr><td colspan="4" class="p-8 text-center text-sm text-zinc-500 dark:text-zinc-400">No branches found.</td></tr>
        <% else %>
          <%= render @branches %>
        <% end %>
      </tbody>
    </table>
  </div>

  <div id="branches-cards" class="flex flex-col gap-4 md:hidden">
    <% if @branches.empty? %>
      <%= render "shared/empty_state", object: "branch" %>
    <% else %>
      <%= render partial: "branches/branch_card", collection: @branches, as: :branch %>
    <% end %>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
<% end %>
