<%= form_with(model: branch, html: { contents: true }) do |form| %>
  <%= render "shared/error_messages", object: branch %>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <%= form.label :name, class: "mb-1 block font-medium" %>
      <%= form.text_field :name, class: "input" %>
    </div>

    <div>
      <%= form.label :contact_phone, class: "mb-1 block font-medium" %>
      <%= form.text_field :contact_phone, class: "input" %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :location, class: "mb-1 block font-medium" %>
      <%= form.text_field :location, class: "input" %>
    </div>
  </div>

  <div class="mt-4 flex items-center gap-3">
    <%= form.submit class: "btn btn--primary" %>
    <%= link_to "Cancel", branches_path, class: "text-sm text-zinc-500 hover:underline dark:text-zinc-400", data: { turbo_frame: "_top" } %>
  </div>
<% end %>
