<div id="<%= dom_id(branch, :card) %>" class="card flex flex-col gap-2 p-4">
  <div class="flex items-start justify-between gap-2">
    <div class="min-w-0">
      <span class="block truncate text-lg font-semibold"><%= link_to branch.name, branch, class: "text-orange-600 hover:underline dark:text-orange-400", data: { turbo_frame: "_top" } %></span>
      <div class="mt-2 space-y-1 text-sm text-zinc-500 dark:text-zinc-400">
        <p class="flex items-center gap-1.5"><%= icon("map-pinned", "h-4 w-4 shrink-0") %><span class="truncate"><%= branch.location %></span></p>
        <p class="flex items-center gap-1.5"><%= icon("phone", "h-4 w-4 shrink-0") %><span class="truncate font-mono"><%= branch.contact_phone.present? ? branch.contact_phone : "—" %></span></p>
      </div>
    </div>
    <div class="flex shrink-0 flex-col items-end gap-2 text-xs">
      <%= link_to "Edit", edit_branch_path(branch), class: "font-medium text-zinc-500 hover:text-orange-500 dark:text-zinc-400", data: { turbo_frame: "modal" } %>
      <% delete_trigger = button_tag "Delete", type: "button", class: "cursor-pointer font-medium text-zinc-500 hover:text-red-500 dark:text-zinc-400", data: { action: "dialog#showModal" } %>
      <%= modal_dialog delete_trigger, size: "450px", title: "Delete '#{branch.name}'?" do %>
        <p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">This will permanently delete this branch. This action cannot be undone.</p>
        <div class="flex items-center justify-end gap-2">
          <button type="button" class="btn" data-action="click->dialog#close">Cancel</button>
          <%= button_to "Continue", branch, method: :delete, class: "btn btn--negative" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
