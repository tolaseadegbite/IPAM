<% dept_employees = employees %>
<% dept_devices = devices %>
<details class="card scroll-mb-28 px-4" id="<%= dom_id(department) %>"
         data-controller="disclosure" data-action="toggle->disclosure#opened">
  <summary class="flex cursor-pointer list-none items-center gap-3 py-3 no-underline hover:no-underline! [&::-webkit-details-marker]:hidden">
    <div class="min-w-0 flex-1">
      <div class="truncate font-semibold">
        <%= link_to department.name, department, class: "hover:text-orange-500 hover:underline", data: { turbo_frame: "_top" } %>
      </div>
      <div class="mt-0.5 text-xs text-zinc-500 tabular-nums dark:text-zinc-400">
        <%= department.employees_count %> employees · <%= department.devices_count %> devices
      </div>
    </div>
    <%= link_to "Add Employee", new_employee_path(department_id: department.id),
          class: "shrink-0 text-xs font-medium text-orange-600 hover:underline dark:text-orange-400",
          data: { turbo_frame: "modal" } %>
    <%= link_to "Add Device", new_device_path(department_id: department.id),
          class: "shrink-0 text-xs font-medium text-orange-600 hover:underline dark:text-orange-400" %>
  </summary>
  <div class="grid grid-cols-1 gap-4 border-t border-zinc-200 py-4 md:grid-cols-2 dark:border-white/10">
              <div>
                <h4 class="label-mono mb-2">Employees</h4>
                <% if dept_employees.any? %>
                <ul id="<%= dom_id(department, :employees) %>" class="flex flex-col gap-2">
          <% dept_employees.each do |employee| %>
            <%= render "departments/employee_show_card", employee: employee %>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-zinc-500 italic dark:text-zinc-400">No employees assigned.</p>
      <% end %>
    </div>
    <div>
      <h4 class="label-mono mb-2">Devices</h4>
      <% if dept_devices.any? %>
        <ul id="<%= dom_id(department, :devices) %>" class="flex flex-col gap-2">
          <% dept_devices.each do |device| %>
            <%= render "departments/device_show_card", device: device %>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-zinc-500 italic dark:text-zinc-400">No devices assigned.</p>
      <% end %>
    </div>
  </div>
</details>
