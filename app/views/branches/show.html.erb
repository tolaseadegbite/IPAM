<% content_for :title, @branch.name %>

<% content_for :page_header do %><%= @branch.name %><% end %>

<% content_for :header_action_buttons do %>
  <div class="hidden items-center gap-2 md:flex">
    <%= link_to "Edit", edit_branch_path(@branch), class: "btn btn--primary !px-3 !py-1.5 text-sm", data: { turbo_frame: "modal" } %>
    <% delete_trigger = button_tag "Delete", type: "button", class: "btn !border-red-200 !px-3 !py-1.5 text-sm !text-red-600 hover:!bg-red-50 dark:!border-red-500/30 dark:!text-red-400 dark:hover:!bg-red-500/10", data: { action: "dialog#showModal" } %>
    <%= modal_dialog delete_trigger, size: "450px", title: "Delete '#{@branch.name}'?" do %>
      <p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">This will permanently delete this branch. This action cannot be undone.</p>
      <div class="flex items-center justify-end gap-2">
        <button type="button" class="btn" data-action="click->dialog#requestClose">Cancel</button>
        <%= button_to "Continue", @branch, method: :delete, data: { turbo: false }, class: "btn btn--negative" %>
      </div>
    <% end %>
  </div>
<% end %>

<%= link_to edit_branch_path(@branch), class: "btn btn--primary fixed right-4 bottom-24 z-30 !rounded-full !p-4 shadow-lg md:hidden",
            data: { turbo_frame: "modal" }, aria: { label: "Edit branch" } do %>
  <%= icon("square-pen", "h-5 w-5") %>
<% end %>

<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <div class="flex flex-col gap-1">
    <nav class="flex items-center gap-1.5 text-xs text-zinc-500 dark:text-zinc-400" aria-label="Breadcrumb">
      <%= link_to "Branches", branches_path, class: "hover:text-orange-500", data: { turbo_frame: "_top" } %>
      <span aria-hidden="true">/</span>
      <span class="font-medium text-zinc-900 dark:text-zinc-100"><%= @branch.name %></span>
    </nav>
    <div class="flex items-center gap-3">
      <%= link_to :back, class: "btn shrink-0 !p-2", aria: { label: "Back" } do %>
        <%= icon("chevron-left", "h-4 w-4") %>
      <% end %>
      <h1 class="truncate text-2xl font-bold tracking-tight sm:text-3xl"><%= @branch.name %></h1>
    </div>
  </div>

  <div id="branch_details" class="card p-4 sm:p-5">
    <%= render "branches/details" %>
  </div>

  <div>
    <div class="mb-4 flex items-center justify-between border-b border-zinc-200 pb-2 dark:border-white/10">
      <h3 class="text-lg font-bold">Departments (<%= @branch.departments.count %>)</h3>
      <%= link_to "Add Dept", new_department_path(branch_id: @branch.id), class: "text-sm font-medium text-orange-600 hover:underline dark:text-orange-400", data: { turbo_frame: "modal" } %>
    </div>

    <% if @departments.any? %>
      <div class="accordion flex flex-col gap-3" id="departments_accordion">
        <% @departments.each do |department| %>
          <%= render "branches/department_section",
                department: department,
                employees: @employees_by_department[department.id] || [],
                devices: @devices_by_department[department.id] || [] %>
        <% end %>
      </div>
    <% else %>
      <div id="empty_state">
        <%= render "shared/empty_state", object: "department" %>
      </div>
    <% end %>
  </div>

  <div>
    <div class="mb-4 flex items-center justify-between border-b border-zinc-200 pb-2 dark:border-white/10">
      <h3 class="text-lg font-bold">Subnets (<%= @subnets.size %>)</h3>
      <%= link_to "All subnets", subnets_path, class: "text-sm font-medium text-orange-600 hover:underline dark:text-orange-400", data: { turbo_frame: "_top" } %>
    </div>

    <% if @subnets.any? %>
      <div class="flex flex-col gap-2">
        <% @subnets.each do |subnet| %>
          <%
            counts = @subnet_usage.select { |(sid, _status)| sid == subnet.id }
            total = counts.values.sum
            used = counts.select { |(_sid, status)| %w[active reserved].include?(status) }.values.sum
            percent = total > 0 ? ((used.to_f / total) * 100).round : 0
            bar_color = if percent > 90 then "bg-red-500"
                        elsif percent > 70 then "bg-amber-400"
                        else "bg-green-500"
                        end
          %>
          <%= link_to subnet, class: "card flex items-center gap-3 p-3 transition hover:border-orange-300 dark:hover:border-orange-500/40", data: { turbo_frame: "_top" } do %>
            <div class="min-w-0 flex-1">
              <div class="truncate text-sm font-bold"><%= subnet.name %></div>
              <div class="truncate font-mono text-xs text-zinc-500 dark:text-zinc-400"><%= subnet.network_address %></div>
            </div>
            <span class="shrink-0 text-xs tabular-nums text-zinc-500 dark:text-zinc-400"><%= used %>/<%= total %></span>
            <div class="h-2 w-24 shrink-0 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-700">
              <div class="h-full rounded-full <%= bar_color %>" style="width: <%= percent %>%;"></div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="py-4 text-center text-xs text-zinc-500 italic dark:text-zinc-400">No subnets assigned to this branch yet.</div>
    <% end %>
  </div>

  <div>
    <%
      branch_query = PaperTrail::Version.where(item_type: "Branch", item_id: @branch.id)
      dept_query = PaperTrail::Version.where(item_type: "Department", item_id: @branch.department_ids)
      combined_versions = branch_query.or(dept_query).order(created_at: :desc).limit(20)
    %>
    <%= render "shared/audit_log", records: combined_versions, parent: @branch %>
  </div>
</div>
