<div class="text-left">
  <h3 class="mb-4 border-b border-zinc-200 pb-2 text-lg font-bold dark:border-white/10">Details</h3>
  <div class="flex flex-wrap justify-between gap-4">
    <div class="mb-4">
      <label class="label-mono">Location</label>
      <div class="mt-0.5 text-sm"><%= @branch.location.present? ? @branch.location : "—" %></div>
    </div>
    <div class="mb-4 text-right">
      <label class="label-mono">Contact</label>
      <div class="mt-0.5 font-mono text-sm"><%= @branch.contact_phone.present? ? @branch.contact_phone : "—" %></div>
    </div>
  </div>
</div>
