<div class="shrink-0 border-t border-zinc-200 p-3 dark:border-white/10">
  <div class="flex flex-col gap-1">
    <div contents data-controller="popover"
         data-popover-placement-value="right-start"
         data-action="click@window->popover#clickOutside">
      <%= button_tag type: "button", class: "sidebar-link w-full", data: { action: "click->popover#toggle", popover_target: "trigger" }, aria: { haspopup: "true" } do %>
        <%= icon("sun", "hidden h-[18px] w-[18px] dark:block") %>
        <%= icon("moon", "h-[18px] w-[18px] dark:hidden") %>
        <span class="flex-1 text-left cursor-pointer">Theme</span>
        <%= icon("chevron-right", "h-4 w-4 opacity-60") %>
      <% end %>
      <%= tag.div popover: "manual", class: "popover", style: "width: 12rem;", data: { popover_target: "content" } do %>
        <div class="menu" data-controller="menu" data-action="keydown->menu#navigate" role="menu">
          <button type="button" class="menu__item" data-action="popover#hide color-scheme#setLight" data-appearance-option="light" data-menu-target="item" role="menuitem">NOC Light</button>
          <button type="button" class="menu__item" data-action="popover#hide color-scheme#setDark" data-appearance-option="dark" data-menu-target="item" role="menuitem">NOC Dark</button>
          <button type="button" class="menu__item" data-action="popover#hide color-scheme#setSystem" data-appearance-option="system" data-menu-target="item" role="menuitem">System</button>
          <div class="my-1 border-t border-zinc-200 dark:border-white/10" role="separator"></div>
          <% [["Osaka Jade", "osaka-jade", ["#111c18", "#509475", "#c1c497"]],
              ["Solitude", "solitude", ["#101315", "#798186", "#cacccc"]],
              ["Giants", "giants", ["#27241f", "#97786d", "#e1d5c2"]],
              ["Retro 82", "retro-82", ["#05182e", "#faa968", "#f6dcac"]],
              ["Miasma", "miasma", ["#222222", "#78824b", "#c2c2b0"]],
              ["Tokyo Night", "tokyo-night", ["#1a1b26", "#7aa2f7", "#a9b1d6"]],
              ["Matte Black", "matte-black", ["#121212", "#e68e0d", "#bebebe"]],
              ["Gruvbox", "gruvbox", ["#282828", "#7daea3", "#d4be98"]],
              ["Everforest", "everforest", ["#2d353b", "#7fbbb3", "#d3c6aa"]]].each do |label, key, (bg, accent, fg)| %>
            <button type="button" class="menu__item" data-action="popover#hide color-scheme#setTheme" data-color-scheme-theme-param="<%= key %>" data-menu-target="item" role="menuitem">
              <span class="inline-flex items-center gap-1" aria-hidden="true">
                <span class="h-2.5 w-2.5 rounded-full border border-white/20" style="background-color: <%= bg %>;"></span>
                <span class="h-2.5 w-2.5 rounded-full" style="background-color: <%= accent %>;"></span>
                <span class="h-2.5 w-2.5 rounded-full" style="background-color: <%= fg %>;"></span>
              </span><%= label %>
            </button>
          <% end %>
        </div>
      <% end %>
    </div>

    <div contents data-controller="popover"
         data-popover-placement-value="right-start"
         data-action="click@window->popover#clickOutside">
      <%= button_tag type: "button", class: "sidebar-link w-full", data: { action: "click->popover#toggle", popover_target: "trigger" }, aria: { haspopup: "true" } do %>
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-orange-500 text-base font-bold text-white">
          <%= current_user.username.first.upcase %>
        </span>
        <span class="min-w-0 flex-1 text-left leading-tight">
          <span class="block truncate font-semibold"><%= current_user.username %></span>
          <span class="block truncate text-xs font-normal opacity-60"><%= current_user.email %></span>
        </span>
      <% end %>
      <%= tag.div popover: "manual", class: "popover overflow-hidden", style: "width: 15rem;", data: { popover_target: "content" } do %>
        <div class="menu" data-controller="menu" data-action="keydown->menu#navigate" role="menu">
          <%= link_to "Account", account_path, class: "menu__item", data: { menu_target: "item" }, role: "menuitem" %>
          <%= button_to "Sign out", Current.session, method: :delete, class: "menu__item w-full text-left text-red-600 dark:text-red-400", role: "menuitem" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
