<div class="shrink-0 border-t border-white/10 p-3">
  <div class="flex flex-col gap-1">
    <div contents data-controller="popover"
         data-popover-placement-value="top-start"
         data-action="click@window->popover#clickOutside">
      <%= button_tag type: "button", class: "sidebar-link w-full", data: { action: "click->popover#toggle", popover_target: "trigger" }, aria: { haspopup: "true" } do %>
        <%= icon("sun", "hidden h-[18px] w-[18px] dark:block") %>
        <%= icon("moon", "h-[18px] w-[18px] dark:hidden") %>
        <span class="flex-1 text-left">Theme</span>
        <%= icon("chevron-right", "h-4 w-4 opacity-60") %>
      <% end %>
      <%= tag.div popover: true, class: "popover", style: "width: 12rem;", data: { popover_target: "content" } do %>
        <div class="menu" data-controller="menu" data-action="keydown->menu#navigate" role="menu">
          <button type="button" class="menu__item" data-action="popover#hide color-scheme#setLight" data-menu-target="item" role="menuitem">Light</button>
          <button type="button" class="menu__item" data-action="popover#hide color-scheme#setDark" data-menu-target="item" role="menuitem">Dark</button>
          <button type="button" class="menu__item" data-action="popover#hide color-scheme#setSystem" data-menu-target="item" role="menuitem">System</button>
        </div>
      <% end %>
    </div>

    <div contents data-controller="popover"
         data-popover-placement-value="top-start"
         data-action="click@window->popover#clickOutside">
      <%= button_tag type: "button", class: "sidebar-link w-full", data: { action: "click->popover#toggle", popover_target: "trigger" }, aria: { haspopup: "true" } do %>
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-orange-500 text-base font-bold text-white">
          <%= current_user.username.first.upcase %>
        </span>
        <span class="min-w-0 flex-1 text-left leading-tight">
          <span class="block truncate font-semibold"><%= current_user.username %></span>
          <span class="block truncate text-xs font-normal opacity-60"><%= current_user.email %></span>
        </span>
      <% end %>
      <%= tag.div popover: true, class: "popover overflow-hidden", style: "width: 15rem;", data: { popover_target: "content" } do %>
        <div class="menu" data-controller="menu" data-action="keydown->menu#navigate" role="menu">
          <%= link_to "My sessions", sessions_path, class: "menu__item", data: { menu_target: "item" }, role: "menuitem" %>
          <%= button_to "Sign out", Current.session, method: :delete, class: "menu__item w-full text-left text-red-600 dark:text-red-400", role: "menuitem" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
