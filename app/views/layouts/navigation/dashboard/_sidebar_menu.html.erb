<div class="flex h-16 shrink-0 items-center gap-2 border-b border-white/10 px-4">
  <%= link_to root_path, class: "flex items-center gap-2.5" do %>
    <%= image_tag("mainline-mark.svg", size: 32, class: "rounded-lg") %>
    <span class="text-lg font-bold tracking-tight text-white">Mainline</span>
  <% end %>
</div>

<nav class="min-h-0 flex-1 overflow-y-auto px-3 py-3" aria-label="Primary">
  <div class="sidebar-label">Overview</div>
  <div class="flex flex-col gap-0.5">
    <%= link_to dashboard_path, class: "sidebar-link",
                aria: (current_page?(dashboard_path) ? { current: "page" } : {}) do %>
      <%= icon("chart-pie", "h-[18px] w-[18px]") %>
      <span>Dashboard</span>
    <% end %>
    <%= link_to boards_path, class: "sidebar-link", aria: active_for("boards") do %>
      <%= icon("kanban", "h-[18px] w-[18px]") %>
      <span>Operations</span>
    <% end %>
  </div>

  <div class="sidebar-label">Inventory</div>
  <div class="flex flex-col gap-0.5">
    <%= link_to subnets_path, class: "sidebar-link", aria: active_for("subnets") do %>
      <%= icon("network", "h-[18px] w-[18px]") %>
      <span>Subnets</span>
    <% end %>
    <%= link_to ip_addresses_path, class: "sidebar-link",
                aria: (controller_name == "ip_addresses" && params[:q].blank? ? { current: "page" } : {}) do %>
      <%= icon("map-pinned", "h-[18px] w-[18px]") %>
      <span>IP Addresses</span>
    <% end %>
    <%= link_to devices_path, class: "sidebar-link",
                aria: (controller_name == "devices" && params[:q].blank? ? { current: "page" } : {}) do %>
      <%= icon("monitor", "h-[18px] w-[18px]") %>
      <span>Devices</span>
    <% end %>
  </div>

  <div class="sidebar-label">Organization</div>
  <div class="flex flex-col gap-0.5">
    <%= link_to branches_path, class: "sidebar-link", aria: active_for("branches") do %>
      <%= icon("building", "h-[18px] w-[18px]") %>
      <span>Branches</span>
    <% end %>
    <%= link_to departments_path, class: "sidebar-link", aria: active_for("departments") do %>
      <%= icon("warehouse", "h-[18px] w-[18px]") %>
      <span>Departments</span>
    <% end %>
    <%= link_to employees_path, class: "sidebar-link", aria: active_for("employees") do %>
      <%= icon("users-round", "h-[18px] w-[18px]") %>
      <span>Employees</span>
    <% end %>
  </div>

  <div class="sidebar-label">Security</div>
  <div class="flex flex-col gap-0.5">
    <%= link_to ip_addresses_path(q: { rogue_only: true }), class: "sidebar-link",
                aria: (current_page?(ip_addresses_path(q: { rogue_only: true })) ? { current: "page" } : {}) do %>
      <%= icon("triangle-alert", "h-[18px] w-[18px]") %>
      <span>Rogue Devices</span>
    <% end %>
    <%= link_to devices_path(q: { critical_eq: true }), class: "sidebar-link",
                aria: (current_page?(devices_path(q: { critical_eq: true })) ? { current: "page" } : {}) do %>
      <%= icon("monitor-x", "h-[18px] w-[18px]") %>
      <span>Critical Devices</span>
    <% end %>
  </div>

  <div class="sidebar-label">Assist</div>
  <div class="flex flex-col gap-0.5">
    <%= link_to chats_path, class: "sidebar-link", aria: active_for("chats") do %>
      <%= icon("message-square-text", "h-[18px] w-[18px]") %>
      <span>NAT Assistant</span>
    <% end %>
  </div>

  <div class="sidebar-label">System</div>
  <div class="flex flex-col gap-0.5">
    <%= link_to admin_users_path, class: "sidebar-link", aria: active_for("users") do %>
      <%= icon("users", "h-[18px] w-[18px]") %>
      <span>Users</span>
    <% end %>
    <%= link_to versions_path, class: "sidebar-link", aria: active_for("versions") do %>
      <%= icon("history", "h-[18px] w-[18px]") %>
      <span>History</span>
    <% end %>
  </div>
</nav>

<%= render "layouts/navigation/dashboard/sidebar_bottom_menu" %>
