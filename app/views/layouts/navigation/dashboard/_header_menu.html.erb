<div class="flex h-16 shrink-0 items-center gap-2 px-3">
  <%= render "layouts/navigation/dashboard/mobile_menu" %>

  <div class="min-w-0 flex-1 truncate text-[15px] font-semibold text-zinc-900 dark:text-zinc-100">
    <%= yield(:page_header).presence || "Dashboard" %>
  </div>

  <div class="hidden min-w-0 flex-1 justify-center px-4 md:flex">
    <%= form_with url: search_path, method: :get, class: "relative w-full max-w-md" do %>
      <span class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2 text-zinc-400">
        <%= icon("search", "h-4 w-4") %>
      </span>
      <%= text_field_tag :query, params[:query], placeholder: "Search devices, IPs, people…",
                         autocomplete: "off",
                         class: "input rounded-full pl-9" %>
    <% end %>
  </div>

  <div class="flex items-center gap-1.5">
    <%= yield :header_action_buttons %>

    <button type="button" class="btn btn--borderless !px-2.5 hidden dark:inline-flex"
            data-action="color-scheme#setLight" title="Switch to light mode">
      <%= icon("sun", "h-[18px] w-[18px]") %>
      <span class="sr-only">Switch to light mode</span>
    </button>
    <button type="button" class="btn btn--borderless !px-2.5 dark:hidden"
            data-action="color-scheme#setDark" title="Switch to dark mode">
      <%= icon("moon", "h-[18px] w-[18px]") %>
      <span class="sr-only">Switch to dark mode</span>
    </button>
  </div>
</div>
