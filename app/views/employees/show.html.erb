<% content_for :title, "#{@employee.first_name} #{@employee.last_name}" %>

<% content_for :page_header do %><%= @employee.first_name %> <%= @employee.last_name %><% end %>

<% content_for :header_action_buttons do %>
  <div class="hidden items-center gap-2 md:flex">
    <%= link_to "Edit Profile", edit_employee_path(@employee), class: "btn btn--primary !px-3 !py-1.5 text-sm",
                data: { turbo_frame: "modal" } %>
    <% delete_trigger = button_tag "Delete", type: "button", class: "btn !border-red-200 !px-3 !py-1.5 text-sm !text-red-600 hover:!bg-red-50 dark:!border-red-500/30 dark:!text-red-400 dark:hover:!bg-red-500/10", data: { action: "dialog#showModal" } %>
    <%= modal_dialog delete_trigger, size: "450px", title: "Delete '#{@employee.full_name}'?" do %>
      <p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">This will permanently delete this employee. This action cannot be undone.</p>
      <div class="flex items-center justify-end gap-2">
        <button type="button" class="btn" data-action="click->dialog#close">Cancel</button>
        <%= button_to "Continue", @employee, method: :delete, data: { turbo: false }, class: "btn btn--negative" %>
      </div>
    <% end %>
  </div>
<% end %>

<%= link_to edit_employee_path(@employee), class: "btn btn--primary fixed right-4 bottom-24 z-30 !rounded-full !p-4 shadow-lg md:hidden",
            data: { turbo_frame: "modal" }, aria: { label: "Edit employee" } do %>
  <%= icon("square-pen", "h-5 w-5") %>
<% end %>

<div class="mx-auto flex w-full max-w-4xl flex-col gap-6">
  <div class="flex items-center gap-3">
    <%= link_to :back, class: "btn shrink-0 !p-2", aria: { label: "Back" } do %>
      <%= icon("chevron-left", "h-4 w-4") %>
    <% end %>
    <h1 class="truncate text-2xl font-bold tracking-tight sm:text-3xl"><%= @employee.full_name %></h1>
  </div>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
    <div id="profile">
      <%= render "employees/profile" %>
    </div>

    <div class="md:col-span-2">
      <div class="card p-4 sm:p-5">
        <h3 class="mb-4 border-b border-zinc-200 pb-2 text-lg font-bold dark:border-white/10">Assigned Assets</h3>
        <% if @employee.devices.any? %>
          <div class="grid grid-cols-1 gap-3">
            <% @employee.devices.each do |device| %>
              <div class="flex items-center justify-between gap-3 rounded-lg border border-zinc-200 p-3 dark:border-white/10">
                <div class="min-w-0">
                  <div class="truncate text-lg font-bold"><%= link_to device.name, device, class: "hover:text-orange-600" %></div>
                  <div class="text-sm text-zinc-500 dark:text-zinc-400"><%= device.device_type.humanize %></div>
                </div>
                <div class="shrink-0 text-right">
                  <% if device.ip_addresses.any? %>
                    <% device.ip_addresses.each do |ip_address| %>
                      <div class="font-mono text-sm font-bold text-sky-600 dark:text-sky-400"><%= ip_address.address %></div>
                    <% end %>
                  <% else %>
                    <div class="text-xs text-zinc-400 italic">No IP</div>
                  <% end %>
                  <div class="mt-1 text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400"><%= device.status %></div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="p-8 text-center text-sm text-zinc-500 dark:text-zinc-400">
            <p>No devices currently assigned.</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div>
    <%
      employee_versions = @employee.versions.order(created_at: :asc).limit(20)
    %>
    <%= render "shared/audit_log", records: employee_versions %>
  </div>
</div>
