<%= render "shared/search_panel" do %>
    <%= search_form_for @search,
        data: {
          controller: "debounce",
          turbo_frame: "employees_table",
          turbo_action: "advance",
          action: "input->debounce#submit change->debounce#submit"
        } do |f| %>
      <div class="grid grid-cols-1 items-end gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <%= f.label :full_name_cont, "Name", class: "mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400" %>
          <%= f.search_field :full_name_cont, placeholder: "Search name…", class: "input",
              data: { action: "input->debounce#submit" } %>
        </div>
        <div>
          <%= f.label :department_branch_id_eq, "Branch", class: "mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400" %>
          <%= f.collection_select :department_branch_id_eq, Branch.order(:name), :id, :name,
                { include_blank: "All Branches" },
                { class: "input cursor-pointer", data: { action: "input->debounce#submit" } } %>
        </div>
        <div>
          <%= f.label :status_eq, "Status", class: "mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400" %>
          <%= f.select :status_eq, Employee.statuses.map { |k, v| [k.humanize, v] },
                { include_blank: "All Statuses" },
                { class: "input cursor-pointer", data: { action: "input->debounce#submit" } } %>
        </div>
        <div class="flex gap-2">
          <%= link_to "Clear", employees_path, class: "btn btn--primary", data: { action: "click->search-filter#resetAll" } %>
        </div>
      </div>
    <% end %>
<% end %>
