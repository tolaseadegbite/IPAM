<% content_for :title, "Employees" %>

<% content_for :page_header do %>Employees (<%= @pagy.count %>)<% end %>

<% content_for :header_action_buttons do %>
  <%= link_to "Onboard Employee", new_employee_path, class: "btn btn--primary hidden !px-3 !py-1.5 text-sm md:inline-flex",
              data: { turbo_frame: "modal" } %>
<% end %>

<%= link_to new_employee_path, class: "btn btn--primary fixed right-4 bottom-24 z-30 !rounded-full !p-4 shadow-lg md:hidden",
            data: { turbo_frame: "modal" }, aria: { label: "Onboard employee" } do %>
  <%= icon("plus", "h-5 w-5") %>
<% end %>

<%= render "search_form" %>

<%= turbo_frame_tag :employees_table do %>
  <%
    # Reject blanks (cleared forms submit empty q values; sort links add
    # only q[s]) so the summary below reflects truly active filters.
    dq = params[:q]&.to_unsafe_h&.reject { |_, v| v.blank? } || {}
    without = ->(key) { employees_path(q: dq.except(key.to_s)) }
    employee_pills = []
    employee_pills << { label: "Name", value: dq["full_name_cont"], url: without.(:full_name_cont), names: "q[full_name_cont]" } if dq["full_name_cont"].present?
    if dq["department_branch_id_eq"].present? && (bname = Branch.find_by(id: dq["department_branch_id_eq"])&.name)
      employee_pills << { label: "Branch", value: bname, url: without.(:department_branch_id_eq), names: "q[department_branch_id_eq]" }
    end
    if dq["status_eq"].present?
      employee_pills << { label: "Status", value: Employee.statuses.key(dq["status_eq"].to_i)&.humanize || dq["status_eq"], url: without.(:status_eq), names: "q[status_eq]" }
    end
  %>
  <% if employee_pills.any? %>
    <p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">Found <strong class="font-semibold text-zinc-900 dark:text-zinc-100"><%= @pagy.count %></strong> <%= "employee".pluralize(@pagy.count) %> matching your filters.</p>
    <%= render "shared/active_filters", pills: employee_pills, clear_url: employees_path %>
  <% end %>
  <div class="overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-white/10 dark:bg-zinc-900">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-zinc-200 px-4 py-2.5 dark:border-white/10">
      <span class="text-[13px] font-semibold tabular-nums"><%= @pagy.count %> employees</span>
      <div class="flex items-center gap-1 text-[13px]">
        <span class="font-medium text-zinc-500 dark:text-zinc-400">Sort:</span>
        <%= sort_link(@search, :full_name, "Name", class: "rounded-md px-2 py-1 font-semibold hover:underline") %>
        <%= sort_link(@search, :status, "Status", class: "rounded-md px-2 py-1 font-semibold hover:underline") %>
      </div>
    </div>
    <div id="employees-list" class="divide-y divide-zinc-200 dark:divide-white/10">
      <% if @employees.empty? %>
        <div class="p-4"><%= render "shared/empty_state", object: "employee" %></div>
      <% else %>
        <%= render partial: "employees/employee", collection: @employees, as: :employee %>
      <% end %>
    </div>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
<% end %>
