<div class="card mt-4 flex flex-col p-0">
  <div class="flex items-center justify-between border-b border-zinc-200 p-4 dark:border-white/10">
    <h3 class="text-lg font-semibold">Maintenance History</h3>
    <%= link_to new_card_path(referenceable_type: parent.class.name, referenceable_id: parent.id),
          class: "btn !px-3 !py-1.5 text-sm", data: { turbo_frame: "modal" } do %>
      Log Task
    <% end %>
  </div>

  <div class="max-h-[300px] overflow-y-auto">
    <% if cards.any? %>
      <table class="w-full text-left text-sm">
        <thead class="sticky top-0 bg-zinc-50 text-xs tracking-wide text-zinc-500 uppercase dark:bg-zinc-900 dark:text-zinc-400">
          <tr>
            <th class="p-3 text-left font-semibold">Status</th>
            <th class="p-3 text-left font-semibold">Task</th>
            <th class="p-3 text-left font-semibold">Priority</th>
            <th class="p-3 text-left font-semibold">Assigned To</th>
            <th class="p-3 text-right font-semibold">Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-200 dark:divide-white/10">
          <% cards.each do |card| %>
            <tr>
              <td class="p-3">
                <span class="rounded-md bg-zinc-100 px-2 py-0.5 font-mono text-xs font-bold whitespace-nowrap text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">
                  <%= card.list.name %>
                </span>
              </td>
              <td class="p-3 font-medium">
                <%= link_to card.title, edit_card_path(card), class: "hover:text-orange-500", data: { turbo_frame: "modal" } %>
              </td>
              <td class="p-3">
                <%
                  p_class = case card.priority
                            when "high" then "bg-red-100 text-red-700 dark:bg-red-500/15 dark:text-red-300"
                            when "medium" then "bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-300"
                            else "bg-sky-100 text-sky-700 dark:bg-sky-500/15 dark:text-sky-300"
                            end
                %>
                <span class="rounded-md px-2 py-0.5 font-bold uppercase <%= p_class %>">
                  <%= card.priority %>
                </span>
              </td>
              <td class="p-3">
                <div class="flex flex-wrap gap-1">
                  <% if card.users.any? %>
                    <% card.users.each do |user| %>
                      <span class="text-xs"><%= user.username.capitalize %></span>
                    <% end %>
                  <% else %>
                    <span class="text-xs text-zinc-400 italic">Unassigned</span>
                  <% end %>
                </div>
              </td>
              <td class="p-3 text-right text-xs whitespace-nowrap text-zinc-500 dark:text-zinc-400">
                <%= time_ago_in_words(card.created_at) %> ago
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <div class="p-8 text-center text-sm text-zinc-500 italic dark:text-zinc-400">
        No maintenance history recorded for this asset.
      </div>
    <% end %>
  </div>
</div>
