<div class="mt-6 border-t border-zinc-200 pt-6 dark:border-white/10">
  <h3 class="mb-4 text-lg font-semibold">Task History</h3>

  <div class="flex max-h-[300px] flex-col gap-4 overflow-y-auto">
    <% versions.each do |version| %>
      <%
         user = User.find_by(id: version.whodunnit)
         username = user ? user.username.capitalize : "System"
         action = version.event
         ignored_fields = %w[id position referenceable_type referenceable_id created_at updated_at]
         filtered_changes = (version.changeset || {}).reject do |field, values|
           ignored_fields.include?(field) || values[0].to_s == values[1].to_s
         end
      %>

      <div class="border-l-2 border-zinc-200 ps-4 dark:border-white/10">
        <div class="mb-1 text-sm">
          <span class="font-bold"><%= username %></span>
          <% if action == "create" %>
            created this task.
          <% elsif action == "destroy" %>
            deleted this task.
          <% elsif filtered_changes.any? %>
            updated this task:
          <% else %>
            modified this task.
          <% end %>
        </div>

        <% if action == "update" && filtered_changes.any? %>
          <ul class="mb-1 list-disc ps-4 text-xs text-zinc-500 dark:text-zinc-400">
            <% filtered_changes.each do |field, values| %>
              <% old_val, new_val = values %>
              <li>
                <% if field == "list_id" %>
                  Moved to <b><%= List.find_by(id: new_val)&.name || "Unknown" %></b> column
                <% elsif old_val.blank? %>
                  Set <span class="rounded-md bg-zinc-100 px-1 font-mono dark:bg-zinc-800"><%= field.humanize %></span> to <b><%= truncate(new_val.to_s, length: 40) %></b>
                <% else %>
                  Changed <span class="rounded-md bg-zinc-100 px-1 font-mono dark:bg-zinc-800"><%= field.humanize %></span>
                  from <i><%= truncate(old_val.to_s, length: 30) %></i>
                  to <b><%= truncate(new_val.to_s, length: 30) %></b>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% end %>

        <div class="font-mono text-xs text-zinc-500 dark:text-zinc-400">
          <%= version.created_at.strftime("%b %d, %H:%M:%S") %>
          (<%= time_ago_in_words(version.created_at) %> ago)
        </div>
      </div>
    <% end %>

    <% if versions.empty? %>
      <div class="text-sm text-zinc-500 italic dark:text-zinc-400">No history available yet.</div>
    <% end %>
  </div>
</div>
