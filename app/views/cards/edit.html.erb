<%= render "shared/modal" do %>
  <div data-action="turbo:submit-end->modal#submitEnd">
    <h2 class="mb-4 text-xl font-bold">Edit Task</h2>

    <%= render "form", card: @card %>

    <div class="mt-6 border-t border-zinc-200 pt-6 dark:border-white/10">
      <h3 class="mb-4 text-lg font-semibold">Task History</h3>
      <%= render "shared/timeline", activities: @activities %>
    </div>
  </div>
<% end %>