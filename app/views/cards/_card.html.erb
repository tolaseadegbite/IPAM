<%
  border_color = case card.priority
                 when "high" then "border-l-4 !border-l-red-500"
                 when "medium" then "border-l-4 !border-l-amber-400"
                 else "border-l-4 !border-l-sky-400"
                 end
%>

<div id="<%= dom_id card %>" data-id="<%= card.id %>" class="card cursor-grab p-3 shadow-sm transition-shadow hover:shadow-md <%= border_color %>">

  <div class="mb-1 text-sm font-medium">
    <%= link_to card.title, edit_card_path(card), data: { turbo_frame: "modal" }, class: "hover:text-orange-500" %>
  </div>

  <% if card.referenceable %>
    <div class="mb-2 flex items-center gap-1.5 rounded-lg border border-zinc-200 bg-zinc-50 p-1.5 text-xs dark:border-white/10 dark:bg-white/5">
      <% if card.referenceable.is_a?(Device) %>
        <%= icon("monitor", "h-3.5 w-3.5 shrink-0 text-zinc-400") %>
        <%= link_to card.referenceable.name, device_path(card.referenceable), class: "truncate hover:underline", data: { turbo_frame: "_top" } %>
      <% elsif card.referenceable.is_a?(IpAddress) %>
        <%= icon("globe", "h-3.5 w-3.5 shrink-0 text-zinc-400") %>
        <%= link_to card.referenceable.address, ip_address_path(card.referenceable), class: "truncate font-mono hover:underline", data: { turbo_frame: "_top" } %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-2 flex items-end justify-between">
    <div class="flex flex-wrap gap-1">
      <% card.users.each do |user| %>
        <span class="rounded-md border border-sky-500 px-2 py-0.5 text-xs text-sky-600 dark:text-sky-400">
          <%= user.username %>
        </span>
      <% end %>
    </div>
    <span class="shrink-0 text-xs text-zinc-400">#<%= card.id %></span>
  </div>
</div>
