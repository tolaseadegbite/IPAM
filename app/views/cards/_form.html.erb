<%= form_with(model: card, html: { contents: true }) do |form| %>
  <%= render "shared/error_messages", object: card %>

  <div class="mbe-4">
    <%= form.label :title, "Task Title", class: "block font-medium mbe-1" %>
    <%= form.text_field :title, class: "input ", placeholder: "e.g. Replace faulty switch" %>
  </div>

  <div class="mbe-4">
    <%= form.label :description, "Description", class: "block font-medium mbe-1" %>
    <%= form.text_area :description, class: "input  h-24" %>
  </div>

  <div class="grid grid-cols-1 grid-cols-2@md gap-4 mbe-4">
    <div class="col-span-1">
      <%= form.label :list_id, "Status (Column)", class: "block font-medium mbe-1" %>
      <%= form.collection_select :list_id, List.all, :id, :name, {}, { class: "input  cursor-pointer" } %>
    </div>

    <div class="col-span-1">
      <%= form.label :priority, "Priority", class: "block font-medium mbe-1" %>
      <%= form.select :priority, Card.priorities.keys.map { |k| [k.humanize, k] }, {}, { class: "input  cursor-pointer" } %>
    </div>
  </div>

  <!-- Assignees (Multiple Select) -->
  <div class="mbe-4">
    <%= form.label :user_ids, "Assign To", class: "block font-medium mbe-1" %>
    <%= form.collection_select :user_ids, User.all, :id, :username, 
          { include_blank: "Unassigned" }, 
          { multiple: true, class: "cursor-pointer", size: 3, data: { controller: "combobox" } } %>
  </div>

  <!-- Linked Asset Section -->
  <div class="mbe-6 p-3 bg-shade border border-main rounded-md">
    <label class="block font-bold text-xs uppercase text-subtle mbe-2">Linked Asset</label>
    
    <% if card.referenceable %>
      <!-- 1. Display mode (if already linked) -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-lg"><%= card.referenceable_type == 'Device' ? '💻' : '🌐' %></span>
          <span class="font-medium text-sm"><%= card.referenceable.respond_to?(:name) ? card.referenceable.name : card.referenceable.address %></span>
        </div>
        
        <!-- Keep the data in the form hidden fields -->
        <%= form.hidden_field :referenceable_type %>
        <%= form.hidden_field :referenceable_id %>
        
        <span class="bg-primary text-white px-2 py-0.5 rounded-full uppercase">Locked</span>
      </div>
    <% else %>
      <!-- 2. Select mode (if creating a generic task) -->
      <div class="flex flex-col gap-2">
        <%= form.select :referenceable_type, [["Device", "Device"], ["IP Address", "IpAddress"]], { include_blank: "Select Type..." }, { class: "input text-xs" } %>
        <%= form.collection_select :referenceable_id, Device.order(:name), :id, :name, { include_blank: "Select Device..." }, { class: "input text-xs" } %>
      </div>
    <% end %>
  </div>

  <!-- Actions -->
  <div class="flex justify-between items-center">
    <div class="flex gap-3 items-center">
      <%= form.submit "Save Task", class: "btn bg-orange-400 text-white font-semibold rounded-md px-4 py-2" %>
      <!-- Close modal button / back link -->
      <%= link_to "Cancel", "#", class: "text-subtle", data: { action: "click->modal#close" } %>
    </div>
    
    <% if card.persisted? %>
      <%= link_to "Delete", card, method: :delete, class: "text-red-500 text-sm hover:underline", data: { turbo_confirm: "Are you sure?" } %>
    <% end %>
  </div>
<% end %>