<tr id="<%= dom_id user, :table_row %>">
  <td class="p-4 font-medium"><%= user.username %></td>
  <td class="p-4 text-sm text-zinc-500 dark:text-zinc-400"><%= user.email %></td>
  <td class="p-4">
    <% if user.admin? %>
      <span class="rounded-md bg-orange-100 px-2 py-0.5 text-xs font-bold text-orange-800 dark:bg-orange-500/15 dark:text-orange-300">ADMIN</span>
    <% else %>
      <span class="text-sm text-zinc-500 dark:text-zinc-400">User</span>
    <% end %>
  </td>
  <td class="p-4">
    <% if user.verified? %>
      <span class="text-sm font-semibold text-green-600 dark:text-green-400">Verified</span>
    <% else %>
      <span class="text-sm text-orange-500">Unverified</span>
    <% end %>
  </td>
  <td class="p-4">
    <div class="flex items-center justify-end gap-3">
      <%= link_to "Edit", edit_admin_user_path(user),
                  class: "text-sm font-medium text-orange-600 hover:underline dark:text-orange-400",
                  data: { turbo_frame: "modal" } %>
      <% delete_trigger = button_tag "Delete", type: "button", class: "cursor-pointer text-sm font-medium text-red-600 hover:underline dark:text-red-400", data: { action: "dialog#showModal" } %>
      <%= modal_dialog delete_trigger, size: "450px", title: "Delete '#{user.username}'?" do %>
        <p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">This will permanently delete this user. This action cannot be undone.</p>
        <div class="flex items-center justify-end gap-2">
          <button type="button" class="btn" data-action="click->dialog#close">Cancel</button>
          <%= button_to "Continue", admin_user_path(user), method: :delete, class: "btn btn--negative" %>
        </div>
      <% end %>
    </div>
  </td>
</tr>
