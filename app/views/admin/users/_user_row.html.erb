<%# Unified user row — the only user list item at every width.
    Locals: user. %>
<div id="<%= dom_id(user) %>" class="flex min-h-16 items-center gap-3 px-4 py-3">
  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-zinc-200 text-sm font-bold dark:bg-zinc-700">
    <%= user.username.first.upcase %>
  </span>
  <span class="min-w-0 flex-1">
    <span class="flex flex-wrap items-center gap-2">
      <span class="truncate text-[14.5px] font-semibold"><%= user.username %></span>
      <% if user.admin? %>
        <span class="shrink-0 rounded-md bg-orange-100 px-2 py-0.5 text-xs font-bold text-orange-800 dark:bg-orange-500/15 dark:text-orange-300">ADMIN</span>
      <% end %>
    </span>
    <span class="mt-0.5 block truncate text-[13px] text-zinc-500 dark:text-zinc-400"><%= user.email %></span>
  </span>
  <% if user.verified? %>
    <span class="flex shrink-0 items-center gap-1 text-xs font-semibold text-green-600 dark:text-green-400"><%= icon("circle-check", "h-3.5 w-3.5") %><span class="hidden sm:inline">Verified</span></span>
  <% else %>
    <span class="shrink-0 text-xs font-medium text-orange-500">Unverified</span>
  <% end %>
  <span class="flex shrink-0 items-center">
    <%= render "shared/row_actions", record: user, show_path: nil,
          edit_path: edit_admin_user_path(user), delete_path: admin_user_path(user),
          record_name: user.username %>
  </span>
</div>
