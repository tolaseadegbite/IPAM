<% content_for :title, "Users" %>

<% content_for :page_header do %>Users (<%= User.count %>)<% end %>

<% content_for :header_action_buttons do %>
  <%= link_to "New User", new_admin_user_path, class: "btn btn--primary hidden !px-3 !py-1.5 text-sm md:inline-flex",
              data: { turbo_frame: "modal" } %>
<% end %>

<%= link_to new_admin_user_path, class: "btn btn--primary fixed right-4 bottom-24 z-30 !rounded-full !p-4 shadow-lg md:hidden",
            data: { turbo_frame: "modal" }, aria: { label: "New user" } do %>
  <%= icon("plus", "h-5 w-5") %>
<% end %>

<%= turbo_frame_tag :users_table do %>
  <div class="overflow-hidden rounded-xl border border-zinc-200 bg-white dark:border-white/10 dark:bg-zinc-900">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-zinc-200 px-4 py-2.5 dark:border-white/10">
      <span class="text-[13px] font-semibold tabular-nums"><%= @pagy.count %> users</span>
      <div class="flex items-center gap-1 text-[13px]">
        <span class="font-medium text-zinc-500 dark:text-zinc-400">Sort:</span>
        <%= sort_link(@search, :username, "Name", class: "rounded-md px-2 py-1 font-semibold hover:underline") %>
        <%= sort_link(@search, :email, "Email", class: "rounded-md px-2 py-1 font-semibold hover:underline") %>
      </div>
    </div>
    <div id="users-list" class="divide-y divide-zinc-200 dark:divide-white/10">
      <% if @users.empty? %>
        <div class="p-4"><%= render "shared/empty_state", object: "user" %></div>
      <% else %>
        <%= render partial: "admin/users/user_row", collection: @users, as: :user %>
      <% end %>
    </div>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
<% end %>
