<% content_for :title, "Users" %>

<% content_for :page_header do %>Users (<%= User.count %>)<% end %>

<% content_for :header_action_buttons do %>
  <%= link_to "New User", new_admin_user_path, class: "btn btn--primary hidden !px-3 !py-1.5 text-sm md:inline-flex",
              data: { turbo_frame: "modal" } %>
<% end %>

<%= link_to new_admin_user_path, class: "btn btn--primary fixed right-4 bottom-24 z-30 !rounded-full !p-4 shadow-lg md:hidden",
            data: { turbo_frame: "modal" }, aria: { label: "New user" } do %>
  <%= icon("plus", "h-5 w-5") %>
<% end %>

<%= turbo_frame_tag :users_table do %>
  <div class="relative hidden overflow-x-auto rounded-xl border border-zinc-200 bg-white md:block dark:border-white/10 dark:bg-zinc-900">
    <table class="table w-full">
      <thead class="bg-zinc-50 dark:bg-white/5">
        <tr>
          <th class="p-3"><%= sort_link(@search, :username, "User") %></th>
          <th class="p-3"><%= sort_link(@search, :email, "Email") %></th>
          <th class="p-3">Role</th>
          <th class="p-3">Status</th>
          <th class="p-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody id="users-table">
        <% if @users.empty? %>
          <tr><td colspan="5" class="p-8 text-center text-sm text-zinc-500 dark:text-zinc-400">No users found.</td></tr>
        <% else %>
          <%= render partial: "admin/users/user_row", collection: @users, as: :user %>
        <% end %>
      </tbody>
    </table>
  </div>

  <div id="users-cards" class="flex flex-col gap-4 md:hidden">
    <% if @users.empty? %>
      <%= render "shared/empty_state", object: "user" %>
    <% else %>
      <%= render partial: "admin/users/user_card", collection: @users, as: :user %>
    <% end %>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
<% end %>
