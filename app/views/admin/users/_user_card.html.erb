<div id="<%= dom_id user, :card %>" class="card flex flex-col p-4">
  <div class="flex items-start justify-between gap-2">
    <div class="flex min-w-0 flex-col gap-1">
      <div class="flex flex-wrap items-center gap-2">
        <span class="truncate text-lg font-semibold"><%= user.username %></span>
        <% if user.admin? %>
          <span class="rounded-md bg-orange-100 px-2 py-0.5 text-xs font-bold text-orange-800 dark:bg-orange-500/15 dark:text-orange-300">ADMIN</span>
        <% end %>
      </div>
      <span class="truncate text-sm text-zinc-500 dark:text-zinc-400"><%= user.email %></span>
      <div class="mt-2">
        <% if user.verified? %>
          <span class="flex items-center gap-1 text-xs text-green-600 dark:text-green-400"><%= icon("circle-check", "h-3.5 w-3.5") %> Verified</span>
        <% else %>
          <span class="text-xs text-orange-500">Unverified</span>
        <% end %>
      </div>
    </div>

    <div class="flex shrink-0 flex-col items-end gap-3">
      <%= link_to "Edit", edit_admin_user_path(user), class: "text-xs font-semibold text-orange-600 dark:text-orange-400", data: { turbo_frame: "modal" } %>
      <% delete_trigger = button_tag "Delete", type: "button", class: "cursor-pointer text-xs text-zinc-500 hover:text-red-500 dark:text-zinc-400", data: { action: "dialog#showModal" } %>
      <%= modal_dialog delete_trigger, size: "400px", title: "Delete user?" do %>
        <p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">Are you sure you want to remove <strong><%= user.username %></strong>?</p>
        <div class="flex items-center justify-end gap-2">
          <button type="button" class="btn" data-action="click->dialog#close">Cancel</button>
          <%= button_to "Delete", admin_user_path(user), method: :delete, class: "btn btn--negative" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
