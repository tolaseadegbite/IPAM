<%= form_with(model: [:admin, user], html: { contents: true, data: { controller: "password-generator" } }) do |form| %>
  <%= render "shared/error_messages", object: user %>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2 mb-4">
    
    <%# --- Row 1: Identity --- %>
    <div>
      <%= form.label :username, class: "mb-1 block font-medium" %>
      <%= form.text_field :username, required: true, autofocus: true, autocomplete: "off", class: "input" %>
    </div>

    <div>
      <%= form.label :email, class: "mb-1 block font-medium" %>
      <%= form.email_field :email, required: true, autocomplete: "off", class: "input" %>
    </div>
  </div>

  <div class="mb-4 grid grid-cols-1 gap-4">
    <%# --- Row 2: Security --- %>
    <div>
      <%= form.label :password, class: "mb-1 block font-medium" %>
      <div class="relative">
        <%= form.password_field :password, 
            placeholder: user.new_record? ? "Required" : "Leave blank to keep current", 
            class: "input", 
            data: { password_generator_target: "input" } %>
            
        <button type="button" 
                data-action="password-generator#toggleVisibility"
                class="absolute right-0 top-0 bottom-0 flex items-center px-3 text-zinc-400 hover:text-orange-500"
                style="right: 0; top: 0; bottom: 0;"
                tabindex="-1">
          <%= icon("eye", "h-4 w-4") %>
        </button>
      </div>
      <% if user.persisted? %>
        <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">Leave blank to keep current password.</p>
      <% end %>
    </div>

    <div>
      <button type="button" 
              data-action="password-generator#generate" 
              class="btn btn--primary w-full"> 
        Generate Secure Password
      </button>
    </div>
  </div>

  <div class="mb-4 grid grid-cols-1 gap-4">
    <%# --- Row 3: Permissions --- %>
    <div class="mt-2 md:col-span-2">
      <fieldset class="flex flex-col gap-2">
        <div class="flex items-center gap-2">
          <%= form.check_box :admin, class: "input" %>
          <%= form.label :admin, "Administrator Access", class: "text-sm font-medium" %>
        </div>
        
        <div class="flex items-center gap-2">
          <%= form.check_box :verified, class: "input" %>
          <%= form.label :verified, "Email Verified", class: "text-sm font-medium" %>
        </div>
      </fieldset>
    </div>
  </div>

  <div class="mt-4 flex items-center gap-3">
    <%= form.submit class: "btn btn--primary" %>
    <%= link_to "Cancel", admin_users_path, class: "text-sm text-zinc-500 hover:underline dark:text-zinc-400", data: { turbo_frame: "_top" } %>
  </div>
<% end %>