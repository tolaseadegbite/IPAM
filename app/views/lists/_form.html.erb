<%= form_with(model: list.persisted? ? list : [board, list], html: { contents: true }) do |form| %>
  <%= render "shared/error_messages", object: list %>

  <div class="mbe-6">
    <%= form.label :name, "Column Name", class: "block font-medium mbe-1" %>
    <%= form.text_field :name, class: "input", placeholder: "e.g., Testing" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "btn bg-orange-400 text-white font-semibold rounded pi-4 pb-2" %>
    <%= link_to "Cancel", "#", class: "text-subtle", data: { action: "click->modal#close" } %>
  </div>
<% end %>