<%= form_with(model: list.persisted? ? list : [board, list], html: { contents: true }) do |form| %>
  <%= render "shared/error_messages", object: list %>

  <div class="mb-6">
    <%= form.label :name, "Column Name", class: "mb-1 block font-medium" %>
    <%= form.text_field :name, class: "input", placeholder: "e.g., Testing" %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "btn btn--primary" %>
    <%= link_to "Cancel", "#", class: "text-sm text-zinc-500 hover:underline dark:text-zinc-400", data: { action: "click->modal#close" } %>
  </div>
<% end %>
