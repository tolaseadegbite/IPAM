<div id="<%= dom_id list %>" data-list-id="<%= list.id %>" class="kanban-column flex-item-no-shrink w-80 flex flex-col max-b-full bg-main border rounded-lg shadow-sm">
  
  <!-- List Header -->
  <%# Added 'list-handle' for functional dragging and 'cursor-grab' for UX %>
  <div class="list-handle cursor-grab p-3 font-bold text-sm border-be border-main flex gap justify-between items-center bg-shade rounded-lg">
    <div class="flex items-center gap-2">
      <span class="text-subtle select-none" title="Drag to reorder">⋮⋮</span>
      <%# Clickable name to Edit %>
      <%= link_to list.name, edit_list_path(list), data: { turbo_frame: "modal" }, class: "hover:text-orange-500" %>
    </div>

    <div class="flex items-center gap-2">
      <span class="text-xs text-reversed bg-black pi-2 pb-1 rounded-full">
        <%= list.cards.size %>
      </span>

      <%# Delete Button (Small icon) %>
      <%= button_to list_path(list), method: :delete, 
            class: "text-subtle hover:text-red-600 border-0 cursor-pointer",
            data: { turbo_confirm: "Delete this column and all its tasks?" } do %>
        <span class="icon icon--trash-2"></span>
      <% end %>
    </div>
  </div>

  <!-- Cards Container (The Sortable Zone) -->
  <div id="<%= dom_id(list, :cards) %>" class="p-2 gap-2 flex flex-col overflow-y-auto" 
       style="min-block-size: 50px;"
       data-controller="kanban"
       data-kanban-url-value="<%= move_card_path(':id') %>"
       data-list-id="<%= list.id %>">
    
    <%# Render the FILTERED cards passed into this partial %>
    <%= render cards %>

    <% if cards.empty? %>
      <div class="p-4 text-center text-xs text-subtle italic opacity-50">
        No matching tasks
      </div>
    <% end %>
  </div>

  <!-- Footer (Add Card) -->
  <div class="p-2 border-bs border-main">
    <%= link_to new_card_path(list_id: list.id), 
          class: "btn btn--primary text-xs border-0", 
          data: { turbo_frame: "modal" } do %>
      <span class="icon icon--plus"></span> Add Task
    <% end %>
  </div>

</div>