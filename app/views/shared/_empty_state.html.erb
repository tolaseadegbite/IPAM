<div class="flex flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-zinc-300 px-6 py-12 text-center dark:border-white/10">
  <%= icon(local_assigns[:icon] || "search", "h-8 w-8 text-zinc-300 dark:text-zinc-600") %>
  <p class="text-sm font-medium"><%= local_assigns[:title] || "No #{object}s found." %></p>
  <% if local_assigns[:description].present? %>
    <p class="max-w-sm text-xs text-zinc-500 dark:text-zinc-400"><%= description %></p>
  <% end %>
  <% if local_assigns[:action].present? %>
    <div class="mt-2"><%= action %></div>
  <% end %>
</div>
