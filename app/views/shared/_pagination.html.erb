<% if pagy.pages > 1 %>
  <div class="mt-4 flex flex-wrap items-center gap-3">
    <div class="hidden text-sm text-zinc-500 md:block dark:text-zinc-400">Total of <%= pagy.count %> record(s).</div>
    <div class="ms-auto flex items-center justify-end gap-4">
      <%= form_with url: pagy_url_for(pagy, 1), class: "hidden items-center gap-2 md:flex", method: :get, data: { controller: "form", action: "change->form#submit" } do |form| %>
        <%= form.label :limit, "Rows per page", class: "text-sm font-medium" %>
        <%= form.select :limit, [10, 20, 30, 40, 50], { selected: pagy.limit }, { class: "input w-[70px]" } %>
      <% end %>
      <div class="text-sm font-medium"><%= "Page #{pagy.page} of #{pagy.pages}" %></div>
      <nav class="flex shrink-0 items-center gap-1.5" aria-label="Pagination">
        <%= link_to pagy_url_for(pagy, 1), class: "btn !p-2", aria: { disabled: pagy.prev.nil? }.compact_blank do %>
          <%= icon("chevrons-left", "h-4 w-4") %>
          <span class="sr-only">Go to first page</span>
        <% end %>
        <%= link_to pagy_url_for(pagy, pagy.prev || pagy.page), class: "btn !p-2", aria: { disabled: pagy.prev.nil? }.compact_blank do %>
          <%= icon("chevron-left", "h-4 w-4") %>
          <span class="sr-only">Go to previous page</span>
        <% end %>
        <%= link_to pagy_url_for(pagy, pagy.next || pagy.page), class: "btn !p-2", aria: { disabled: pagy.next.nil? }.compact_blank do %>
          <%= icon("chevron-right", "h-4 w-4") %>
          <span class="sr-only">Go to next page</span>
        <% end %>
        <%= link_to pagy_url_for(pagy, pagy.last), class: "btn !p-2", aria: { disabled: pagy.next.nil? }.compact_blank do %>
          <%= icon("chevrons-right", "h-4 w-4") %>
          <span class="sr-only">Go to last page</span>
        <% end %>
      </nav>
    </div>
  </div>
<% end %>
