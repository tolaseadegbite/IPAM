<%= form_with(model: message, url: [@chat, message], id: "new_message", class: "flex flex-col gap-2") do |form| %>

  <div>
      <%= form.text_area :content, placeholder: "Message...", autofocus: true, class: "input" %>
  </div>

  <div class="flex items-end justify-between gap-2 pb-1">
    <div class="gap-2 flex items-center">
      <div class="flex w-fit items-center gap-1 self-start rounded-full bg-zinc-200 p-0.5 dark:bg-zinc-800" role="group" aria-label="Assistant mode"
           data-controller="mode-toggle" data-action="keydown@window->mode-toggle#escape">
        <% [["Plan", "plan"], ["Build", "build"]].each do |label, key| %>
          <% active = chat.mode == key %>
          <button type="button" data-action="click->mode-toggle#switch"
                data-mode-toggle-mode-param="<%= key %>" data-mode-toggle-url-param="<%= chat_path(chat) %>"
                class="rounded-full px-3 py-1 text-xs font-semibold <%= active ? "bg-orange-500 text-white shadow-sm" : "text-zinc-500 dark:text-zinc-400" %>"
                aria-pressed="<%= active %>" title="<%= active ? "#{label} mode (current, Esc to switch)" : "Switch to #{label.downcase} mode (Esc)" %>"><%= label %></button>
        <% end %>
      </div>
      <div class="flex items-center gap-2">
          <%= tag.div class: "flex items-center gap-1", data: {
            controller: "dropzone",
            dropzone_param_name_value: "message[attachment_ids][]",
            dropzone_url_value: rails_direct_uploads_url,
            dropzone_accepted_files_value: "image/*,.csv,.xls,.xlsx,.pdf",
            dropzone_max_files_value: 5,
            dropzone_max_filesize_value: 10
          } do %>
            <button type="button" class="btn btn--icon btn--plain border-0 !p-2 text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100"
                    data-action="click->dropzone#browse" title="Attach photos, CSVs, or Excel files" aria-label="Attach files">
              <%= icon("paperclip", "h-[18px] w-[18px]") %>
            </button>
          <% end %>
      </div>
    </div>
    <%= form.submit "Send", class: "btn btn--primary" %>
  </div>
<% end %>
