<%= form_with(model: message, url: [@chat, message], id: "new_message", class: "flex gap-2 items-center") do |form| %>
  <div class="flex-1">
      <%= form.text_area :content, placeholder: "Message...", autofocus: true, class: "input" %>
  </div>

  <div>
    <%= form.submit "Send", class: "btn btn--primary" %>
  </div>
<% end %>
