<div id="message_<%= tool_calls.id %>" class="rounded-lg border-l-[3px] border-zinc-400 bg-zinc-100 p-3 dark:border-zinc-500 dark:bg-white/5">
  <div class="mb-1 text-[13px] font-bold text-zinc-700 dark:text-zinc-200">Tool Call</div>
  <pre class="m-0 font-mono text-[13px] whitespace-pre-wrap text-zinc-900 dark:text-zinc-100"><%= tool_call.name %>(<%= tool_call.arguments.map { |k, v| "#{k}: #{v.inspect}" }.join(", ") %>)</pre>
  <div class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
    <%= tool_calls.created_at&.strftime("%I:%M %p") %>
  </div>
</div>
