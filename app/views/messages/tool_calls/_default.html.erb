<div id="message_<%= tool_calls.id %>" class="message"
     style="margin-bottom: 8px; padding: 8px 12px; border-left: 3px solid #6b7280; background: #f3f4f6; border-radius: 6px;">
  <div style="font-weight: bold; margin-bottom: 4px; font-size: 0.85em; color: #374151;">Tool Call</div>
  <pre style="white-space: pre-wrap; margin: 0; color: #111827; font-size: 0.85em;"><%= tool_call.name %>(<%= tool_call.arguments.map { |k, v| "#{k}: #{v.inspect}" }.join(", ") %>)</pre>
  <div style="font-size: 0.75em; color: #6b7280; margin-top: 4px;">
    <%= tool_calls.created_at&.strftime("%I:%M %p") %>
  </div>
</div>
