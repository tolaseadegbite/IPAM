<div id="message_<%= message.id %>" class="message"
     style="margin-bottom: 8px; padding: 8px 12px; border-left: 3px solid #dc2626; background: #fef2f2; color: #991b1b; border-radius: 6px;">
  <div style="font-weight: bold; margin-bottom: 4px; font-size: 0.85em;"><%= title.presence || "Error" %></div>
  <pre style="white-space: pre-wrap; margin: 0; font-size: 0.85em;"><%= error_message %></pre>
  <div style="font-size: 0.75em; opacity: 0.8; margin-top: 4px;">
    <%= message.created_at&.strftime("%I:%M %p") %>
  </div>
</div>
