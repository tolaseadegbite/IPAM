<div id="message_<%= message.id %>" class="rounded-lg border-l-[3px] border-red-500 bg-red-50 p-3 text-red-900 dark:border-red-500 dark:bg-red-500/10 dark:text-red-200">
  <div class="mb-1 text-[13px] font-bold"><%= title.presence || "Error" %></div>
  <pre class="m-0 text-[13px] whitespace-pre-wrap"><%= error_message %></pre>
  <div class="mt-1 text-xs opacity-80">
    <%= message.created_at&.strftime("%I:%M %p") %>
  </div>
</div>
