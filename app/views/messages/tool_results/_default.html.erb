<% error_message = tool.tool_error_message %>
<% if error_message.present? %>
  <%= render "messages/error",
    message: tool,
    title: "Tool Result Error",
    error_message: error_message %>
<% else %>
  <div id="message_<%= tool.id %>" class="message"
       style="margin-bottom: 8px; padding: 8px 12px; border-left: 3px solid #6b7280; background: #f3f4f6; border-radius: 6px;">
    <div style="font-weight: bold; margin-bottom: 4px; font-size: 0.85em; color: #374151;">Tool</div>
    <pre style="white-space: pre-wrap; margin: 0; color: #111827; font-size: 0.85em;"><%= tool.content.presence || "(no output)" %></pre>
    <div style="font-size: 0.75em; color: #6b7280; margin-top: 4px;">
      <%= tool.created_at&.strftime("%I:%M %p") %>
    </div>
  </div>
<% end %>
