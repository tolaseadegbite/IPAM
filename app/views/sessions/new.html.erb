<div class="card w-full p-6 sm:p-8" style="max-width: 25rem;">
  <div class="mb-6 text-center">
    <%= link_to root_path, class: "mb-5 inline-flex items-center gap-2" do %>
      <%= image_tag("mainline-mark.svg", size: 56, class: "rounded-xl") %>
      <span class="text-3xl font-bold tracking-tight">Mainline</span>
    <% end %>
    <h1 class="text-2xl font-semibold">Sign in</h1>
    <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Network inventory, at a glance.</p>
  </div>

  <%= form_with(url: sign_in_path, class: "flex flex-col gap-4") do |form| %>
    <div>
      <%= form.label :username, class: "mb-1 block text-sm font-semibold" %>
      <%= form.text_field :username, value: params[:username_hint], placeholder: "tolase", required: true, autofocus: true, autocomplete: "username", class: "input" %>
    </div>

    <div>
      <%= form.label :password, class: "mb-1 block text-sm font-semibold" %>
      <%= form.password_field :password, required: true, placeholder: "••••••••••••", autocomplete: "current-password", class: "input" %>
    </div>

    <%= form.submit "Sign in", class: "btn btn--primary w-full" %>
  <% end %>

  <div class="mt-6 text-center text-sm">
    <%= link_to "Forgot your password?", new_identity_password_reset_path, class: "font-medium text-orange-600 hover:underline dark:text-orange-400" %>
  </div>
</div>
