<%# Unified department row — the only department list item at every width.
    Locals: department. %>
<div id="<%= dom_id(department) %>" class="flex min-h-16 items-center gap-3 px-4 py-3">
  <span class="min-w-0 flex-1">
    <span class="block truncate text-[14.5px] font-semibold">
      <%= link_to department.name, department, class: "hover:text-orange-500", data: { turbo_frame: "_top" } %>
    </span>
    <span class="mt-0.5 block truncate text-[13px] text-zinc-500 dark:text-zinc-400">
      <%= department.branch.name %>
      <span class="tabular-nums"> · <%= department.employees_count %> people · <%= department.devices_count %> devices</span>
    </span>
  </span>
  <span class="flex shrink-0 items-center">
    <%= render "shared/row_actions", record: department, show_path: department,
          edit_path: edit_department_path(department), delete_path: department,
          record_name: department.name %>
  </span>
</div>
