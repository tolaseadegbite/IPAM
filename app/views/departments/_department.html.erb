<tr id="<%= dom_id(department, :table_row) %>">
  <td class="p-3 font-semibold"><%= link_to department.name, department, class: "text-orange-600 hover:underline dark:text-orange-400", data: { turbo_frame: "_top" } %></td>
  <td class="p-3 text-sm"><%= department.branch.name %></td>
  <td class="p-3">
    <div class="flex items-center justify-end gap-3">
      <%= link_to "Edit", edit_department_path(department),
                  class: "text-sm font-medium text-orange-600 hover:underline dark:text-orange-400",
                  data: { turbo_frame: "modal" } %>
      <% delete_trigger = button_tag "Delete", type: "button", class: "cursor-pointer text-sm font-medium text-red-600 hover:underline dark:text-red-400", data: { action: "dialog#showModal" } %>
      <%= modal_dialog delete_trigger, size: "450px", title: "Delete '#{department.name}'?" do %>
        <p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">This will permanently delete this department. This action cannot be undone.</p>
        <div class="flex items-center justify-end gap-2">
          <button type="button" class="btn" data-action="click->dialog#close">Cancel</button>
          <%= button_to "Continue", department, method: :delete, class: "btn btn--negative" %>
        </div>
      <% end %>
    </div>
  </td>
</tr>
