<%= render "shared/search_panel" do %>
    <%= search_form_for @search,
        data: {
          controller: "debounce",
          turbo_frame: "departments_table",
          turbo_action: "advance",
          action: "input->debounce#submit change->debounce#submit"
        } do |f| %>
      <div class="grid grid-cols-1 items-end gap-4 md:grid-cols-3">
        <div>
          <%= f.label :name_cont, "Department Name", class: "mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400" %>
          <%= f.search_field :name_cont, placeholder: "Search…", class: "input",
              data: { action: "input->debounce#submit" } %>
        </div>
        <div>
          <%= f.label :branch_id_eq, "Branch", class: "mb-1 block text-xs font-bold tracking-wide text-zinc-500 uppercase dark:text-zinc-400" %>
          <%= f.collection_select :branch_id_eq, Branch.order(:name), :id, :name,
                { include_blank: "All Branches" },
                { class: "input cursor-pointer", data: { action: "change->debounce#submit" } } %>
        </div>
        <div class="flex gap-2">
          <%= link_to "Clear", departments_path, class: "btn btn--primary", data: { action: "click->search-filter#resetAll" } %>
        </div>
      </div>
    <% end %>
<% end %>
