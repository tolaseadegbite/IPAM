<%# 1. Use params[:frame_id] if provided, otherwise default to existing ID %>
<%= turbo_frame_tag params[:frame_id] || "department_options_frame" do %>
  <% 
     target_model = params[:target_model] || "employee" 
     input_name = params[:field_name] || "#{target_model}[department_id]"
     
     html_options = {
       prompt: "All Departments", # Changed prompt to be generic
       class: "input cursor-pointer",
       id: "#{target_model}_department_id"
     }

     # Logic for existing forms (Device/Employee)
     should_trigger = (target_model == "device") || (params[:trigger] == "true")

     # 2. Build Actions List
     # We combine existing dependent logic with any new actions passed via params (like debounce)
     actions = []
     actions << "change->dependent-select#load" if should_trigger
     actions << params[:data_action] if params[:data_action].present?
     # Subnet scoping is inert on forms without a subnet-scope ancestor.
     actions << "change->subnet-scope#filter"

     # Apply Data Attributes
     if actions.any? || should_trigger
       html_options[:data] = {}
       html_options[:data][:action] = actions.join(" ") if actions.any?
       html_options[:data][:dependent_select_target] = "select" if should_trigger
       html_options[:data][:subnet_scope_target] = "department"
     end
  %>
  
  <%= select_tag input_name,
        options_for_select(departments.map { |d| [ d.name, d.id, { "data-branch-id" => d.branch_id } ] }),
        html_options %>
<% end %>