<% content_for :title, "Departments" %>

<% content_for :page_header do %>Departments (<%= @pagy.count %>)<% end %>

<% content_for :header_action_buttons do %>
  <%= link_to "New Department", new_department_path, class: "btn btn--primary hidden !px-3 !py-1.5 text-sm md:inline-flex",
              data: { turbo_frame: "modal" } %>
<% end %>

<%= link_to new_department_path, class: "btn btn--primary fixed right-4 bottom-24 z-30 !rounded-full !p-4 shadow-lg md:hidden",
            data: { turbo_frame: "modal" }, aria: { label: "New department" } do %>
  <%= icon("plus", "h-5 w-5") %>
<% end %>

<%= render "search_form" %>

<%= turbo_frame_tag :departments_table do %>
  <div class="relative hidden overflow-x-auto rounded-xl border border-zinc-200 bg-white md:block dark:border-white/10 dark:bg-zinc-900">
    <table class="table w-full">
      <thead class="bg-zinc-50 dark:bg-white/5">
        <tr>
          <th class="p-3"><%= sort_link(@search, :name, "Department") %></th>
          <th class="p-3"><%= sort_link(@search, :branch_name, "Branch") %></th>
          <th class="p-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody id="departments-table">
        <% if @departments.empty? %>
          <tr><td colspan="3" class="p-8 text-center text-sm text-zinc-500 dark:text-zinc-400">No departments found.</td></tr>
        <% else %>
          <%= render @departments %>
        <% end %>
      </tbody>
    </table>
  </div>

  <div id="departments-cards" class="flex flex-col gap-4 md:hidden">
    <% if @departments.empty? %>
      <%= render "shared/empty_state", object: "department" %>
    <% else %>
      <%= render partial: "departments/department_card", collection: @departments, as: :department %>
    <% end %>
  </div>

  <%= render "shared/pagination", pagy: @pagy %>
<% end %>
