<div id="<%= dom_id department, :card %>" class="card flex flex-col gap-3 p-4">
  <div class="flex items-start justify-between gap-2">
    <div class="min-w-0">
      <span class="block truncate text-lg font-semibold"><%= link_to department.name, department, class: "text-orange-600 hover:underline dark:text-orange-400", data: { turbo_frame: "_top" } %></span>
      <div class="mt-2 space-y-1.5 text-sm text-zinc-500 dark:text-zinc-400">
        <div class="flex items-center gap-2">
          <%= icon("building", "h-4 w-4 shrink-0") %>
          <span class="truncate">Located in <strong class="font-semibold text-zinc-700 dark:text-zinc-200"><%= department.branch.name %></strong></span>
        </div>
        <div class="flex items-center gap-3">
          <span><%= department.employees_count %> employees</span>
          <span>·</span>
          <span><%= department.devices_count %> devices</span>
        </div>
      </div>
    </div>
    <div class="flex shrink-0 flex-col items-end gap-2 text-xs">
      <%= link_to "Edit", edit_department_path(department), class: "font-medium text-zinc-500 hover:text-orange-500 dark:text-zinc-400", data: { turbo_frame: "modal" } %>
      <% delete_trigger = button_tag "Delete", type: "button", class: "cursor-pointer font-medium text-zinc-500 hover:text-red-500 dark:text-zinc-400", data: { action: "dialog#showModal" } %>
      <%= modal_dialog delete_trigger, size: "450px", title: "Delete '#{department.name}'?" do %>
        <p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">This will permanently delete this department. This action cannot be undone.</p>
        <div class="flex items-center justify-end gap-2">
          <button type="button" class="btn" data-action="click->dialog#close">Cancel</button>
          <%= button_to "Continue", department, method: :delete, class: "btn btn--negative" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
