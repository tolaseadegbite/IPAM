<%= form_with(model: department, html: { contents: true }) do |form| %>
  <%= render "shared/error_messages", object: department %>

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
    <div>
      <%= form.label :name, "Department name", class: "mb-1 block font-medium" %>
      <%= form.text_field :name, autofocus: true, class: "input" %>
    </div>

    <div>
      <%= form.label :branch_id, class: "mb-1 block font-medium" %>
      <% if department.branch_id %>
        <%= form.hidden_field :branch_id %>
        <%= form.collection_select :branch_id, Branch.order(:name), :id, :name, {},
              { class: "input", disabled: true } %>
      <% else %>
        <%= form.collection_select :branch_id, Branch.order(:name), :id, :name,
              { prompt: "Select Branch" }, { class: "input cursor-pointer" } %>
      <% end %>
    </div>
  </div>

  <div class="mt-4 flex items-center gap-3">
    <%= form.submit class: "btn btn--primary" %>
    <%= link_to "Cancel", departments_path, class: "text-sm text-zinc-500 hover:underline dark:text-zinc-400", data: { turbo_frame: "_top" } %>
  </div>
<% end %>
