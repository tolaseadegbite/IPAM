<% content_for :title, @department.name %>

<% content_for :page_header do %><%= @department.name %><% end %>

<% content_for :header_action_buttons do %>
  <div class="hidden items-center gap-2 md:flex">
    <%= link_to "Edit", edit_department_path(@department), class: "btn btn--primary !px-3 !py-1.5 text-sm", data: { turbo_frame: "modal" } %>
    <% delete_trigger = button_tag "Delete", type: "button", class: "btn !border-red-200 !px-3 !py-1.5 text-sm !text-red-600 hover:!bg-red-50 dark:!border-red-500/30 dark:!text-red-400 dark:hover:!bg-red-500/10", data: { action: "dialog#showModal" } %>
    <%= modal_dialog delete_trigger, size: "450px", title: "Delete '#{@department.name}'?" do %>
      <p class="mb-4 text-sm text-zinc-500 dark:text-zinc-400">This will permanently delete this department. This action cannot be undone.</p>
      <div class="flex items-center justify-end gap-2">
        <button type="button" class="btn" data-action="click->dialog#close">Cancel</button>
        <%= button_to "Continue", @department, method: :delete, data: { turbo: false }, class: "btn btn--negative" %>
      </div>
    <% end %>
  </div>
<% end %>

<%= link_to edit_department_path(@department), class: "btn btn--primary fixed right-4 bottom-24 z-30 !rounded-full !p-4 shadow-lg md:hidden",
            data: { turbo_frame: "modal" }, aria: { label: "Edit department" } do %>
  <%= icon("square-pen", "h-5 w-5") %>
<% end %>

<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <div class="flex items-center gap-3">
    <%= link_to :back, class: "btn shrink-0 !p-2", aria: { label: "Back" } do %>
      <%= icon("chevron-left", "h-4 w-4") %>
    <% end %>
    <div id="department_details" class="min-w-0">
      <%= render "departments/department_details" %>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
    <div>
      <div class="mb-4 flex items-center justify-between border-b border-zinc-200 pb-2 dark:border-white/10">
        <h3 class="text-lg font-bold">Employees (<%= @department.employees.count %>)</h3>
        <%= link_to "Add Employee", new_employee_path(department_id: @department.id), class: "text-sm font-medium text-orange-600 hover:underline dark:text-orange-400", data: { turbo_frame: "modal" } %>
      </div>
      <%= content_tag(:ul, id: dom_id(@department, :employees), class: "flex flex-col gap-2") do %>
        <% @employees.each do |employee| %>
          <%= render "departments/employee_show_card", employee: employee %>
        <% end %>
      <% end %>
      <% if @department.employees.empty? %>
        <p id="no_employees_message" class="mt-2 text-sm text-zinc-500 italic dark:text-zinc-400">No employees assigned.</p>
      <% end %>
    </div>

    <div>
      <div class="mb-4 flex items-center justify-between border-b border-zinc-200 pb-2 dark:border-white/10">
        <h3 class="text-lg font-bold">Devices (<%= @department.devices.count %>)</h3>
        <%= link_to "Add Device", new_device_path(department_id: @department.id), class: "text-sm font-medium text-orange-600 hover:underline dark:text-orange-400", data: { turbo_frame: "modal" } %>
      </div>
      <%= content_tag(:ul, id: dom_id(@department, :devices), class: "flex flex-col gap-2") do %>
        <% @devices.each do |device| %>
          <%= render "departments/device_show_card", device: device %>
        <% end %>
      <% end %>
      <% if @department.devices.empty? %>
        <p id="no_devices_message" class="mt-2 text-sm text-zinc-500 italic dark:text-zinc-400">No devices assigned.</p>
      <% end %>
    </div>
  </div>

  <div>
    <%
      dept_query = PaperTrail::Version.where(item_type: "Department", item_id: @department.id)
      emp_query = PaperTrail::Version.where(item_type: "Employee", item_id: @department.employee_ids)
      dev_query = PaperTrail::Version.where(item_type: "Device", item_id: @department.device_ids)
      combined_versions = dept_query.or(emp_query).or(dev_query).order(created_at: :desc).limit(20)
    %>
    <%= render "shared/audit_log", records: combined_versions, parent: @department %>
  </div>
</div>
