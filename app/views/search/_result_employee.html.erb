<div class="card p-4 transition hover:border-orange-300 dark:hover:border-orange-500/40">
  <div class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 items-center gap-3">
      <div class="flex shrink-0 items-center gap-1.5 rounded-lg bg-zinc-200 p-2 text-zinc-700 dark:bg-zinc-700 dark:text-zinc-200">
        <%= icon("user", "h-4 w-4") %>
        <span class="text-[11px] font-bold uppercase">Staff</span>
      </div>
      <div class="min-w-0">
        <h3 class="truncate text-lg font-semibold"><%= link_to "#{item.first_name} #{item.last_name}", item, data: { turbo_frame: "_top" }, class: "text-orange-600 hover:underline dark:text-orange-400" %></h3>
      </div>
    </div>
    <div class="shrink-0 text-right text-sm">
      <%
        status_badge = case item.status
          when "active" then "bg-green-100 text-green-800 dark:bg-green-500/15 dark:text-green-300"
          when "on_leave" then "bg-amber-100 text-amber-800 dark:bg-amber-500/15 dark:text-amber-300"
          when "terminated" then "bg-red-100 text-red-800 dark:bg-red-500/15 dark:text-red-300"
          else "bg-zinc-100 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300"
          end
      %>
      <span class="rounded-lg border border-zinc-200 px-2 py-0.5 text-xs font-semibold uppercase dark:border-white/10 <%= status_badge %>"><%= item.status %></span>
    </div>
  </div>
</div>
