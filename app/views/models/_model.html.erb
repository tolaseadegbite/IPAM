<% model_id = model.respond_to?(:model_id) ? model.model_id : model.id %>
<% row_id = [model.provider, model_id].join("_").parameterize(separator: "_") %>
<tr id="model_<%= row_id %>">
  <td class="p-3 text-sm"><%= model.provider_class&.name || model.provider %></td>
  <td class="p-3 text-sm font-medium"><%= model.respond_to?(:display_name) ? model.display_name : model.name %></td>
  <td class="p-3 font-mono text-sm tabular-nums"><%= number_with_delimiter(model.context_window) if model.context_window %></td>
  <td class="p-3 font-mono text-sm tabular-nums">
    <% input = model.input_price_per_million %>
    <% output = model.output_price_per_million %>
    <% if input && output %>
      $<%= "%.2f" % input %> / $<%= "%.2f" % output %>
    <% end %>
  </td>
  <td class="p-3 text-right"><%= link_to "Start chat", new_chat_path(model: model_id), class: "text-sm font-medium text-orange-600 hover:underline dark:text-orange-400" %></td>
</tr>
